# Resolve every package as the registry stood on this date, so nothing newer than a week old
# comes in, including the dependencies of dependencies. Move the date forward on purpose.
before=2026-11-19T00:00:00.000Z
# Copy file: dependencies into node_modules instead of linking them. @prompting-time/ui is a local
# package until its first npm release, and a link would install its dependencies in that checkout
# and load a second copy of Solid from there.
install-links=true
# Run no install scripts of dependencies; none of these needs one.
ignore-scripts=true
