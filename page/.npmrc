# Resolve every package as the registry stood on this date, including the dependencies of
# dependencies. The date normally sits a week before the day a dependency changes, so nothing newer
# than a week old comes in; for now it sits just after @prompting-time/ui 0.1.0 was published, so
# any package npm install resolves may be that new. At the next dependency change, set it a week
# before that day. Move the date only on purpose.
before=2026-11-28T06:00:00.000Z
# Run no install scripts of dependencies; none of these needs one.
ignore-scripts=true
