#!/usr/bin/env bash
# Prints Whooper's status as one JSON object, read from the files under <state> with no network
# calls, where <state> is $XDG_STATE_HOME/whooper (default ~/.local/state/whooper):
#
#   whooper-status --json
#
#   version     1, the number of this format
#   loop        running: whether whooper-run runs, that is, its lock's process is alive and is a
#               whooper-run; pid: that process's ID, or null
#   paused      whether bin/whooper-pause paused the schedule
#   next_round  when the round whooper-run waits for starts, or null while no whooper-run waits
#   round       running, the same check for whooper-round; started_at; reviewing: the PR the round
#               is reviewing, or null
#   last_round  null until a round ends, then its started_at, ended_at, result (done, poll_failed,
#               or interrupted), selected (how many items it selected, or null when it ended before
#               selecting), and reviews: [{pr, outcome}], where pr reads <owner>/<repo>#<number> and
#               outcome is reviewed, failed, interrupted, or waiting, for a review the round did not
#               start after another stopped at a cause that stops every review
#   blocked     what stops every review now, or null: {id, summary, scope, since, waiting}, the cause
#               of the newest review that ended or waits, while its scope is all, as each review's
#               cause below has it; since, when the first of the reviews just before it that stopped
#               or wait at the same cause ended, or started for one that waits; and waiting, how
#               many PRs' newest review waits, leaving out one the user removed, which the next round
#               does not review. A review that runs is passed over, and null comes back
#               once a review succeeds or stops at a cause of its PR's own
#   reviews     the review runs in <state>/runs that started in the last 30 days, newest first, each
#               {run_id, repo, pr, title, author, url, started_at, ended_at, outcome, verdict, skipped,
#               findings, safe_to_approve, submitted, needs_you, cause, head_sha, pr_head_sha,
#               skipped_by_user, removed_by_user}:
#     repo        <owner>/<repo>, from run.json, or null when run.json cannot be read, as when
#                 whooper-review stopped before it wrote the file
#     pr          the PR's number, from the run ID, <UTC start time>-<PR number>
#     title       the PR's title in github.json, or null when the review's GitHub fetch failed or the
#                 file cannot be read
#     author      the login of the PR's author in github.json, or null the same way
#     url         the PR's address, or null without the repo
#     started_at  when the run started, from its ID
#     ended_at    when whooper-review saved failure.txt as it stopped the review, or else when the
#                 run wrote findings.json; null while the review runs or waits, and when neither file
#                 exists
#     outcome     running while a live whooper-review holds the PR's lock for the run, the rule
#                 whooper-ask follows; waiting for a review whooper-round did not start, because an
#                 earlier review in its round stopped at a cause that stops every review, which the
#                 next round reviews again; reviewed once the review left findings that fit
#                 schemas/findings.json and no failure.txt; failed otherwise
#     verdict     approve_once_ci_passes or look_first, from findings that fit, or null
#     skipped     whether the review skipped the PR, as it does a large PR from an untagged ask
#     findings    how many findings it has, 0 when findings.json is missing or does not fit; a
#                 review that runs counts none yet, since a Devin review may still change the file
#     safe_to_approve true exactly when whooper-submit would approve the review without
#                 --approve-anyway: the outcome is reviewed, its verdict is approve_once_ci_passes,
#                 every finding is a nit, and it did not skip the PR (lib/whooper.py's run_concerns);
#                 false for any other review, as for one that runs, which whooper-submit refuses,
#                 waits, or failed, even with findings that fit
#     submitted   null, or {event, at} once whooper-submit posted the review: APPROVE or COMMENT, and
#                 when submit.json recorded it; a submit.json that says posting counts as null, since
#                 its review may or may not be on GitHub
#     needs_you   true for a review that ended, reviewed or failed, and is not submitted, until a newer
#                 run of the same repo and PR starts, which supersedes it, even one that waits; false
#                 while the user marks it skipped or removed
#     cause       for a failed review, what stopped it, {id, summary, scope}; for one that waits,
#                 the cause it waits on, from its waiting.json; null otherwise. scope is all for a
#                 cause that stops every review: docker_unavailable (the repo's setup script could
#                 not reach Docker), setup_failed (it failed otherwise), and gh_signed_out; and pr
#                 for one that stops this PR's: repo_not_configured (no clone of the repo),
#                 agent_no_findings, time_limit, and unknown, such as an interrupted review. It
#                 comes from failure.json, which whooper-review saves as it stops the review, or for
#                 an older review from the wording of failure.txt, and is unknown without either
#     head_sha    the commit the review reviewed, or for one that waits would review, from run.json,
#                 or null without it
#     pr_head_sha the PR's newest head Whooper knows: of the heads its latest poll saw
#                 (<state>/poll/github.json and the newest poll's items), the recheck list holds,
#                 and the PR's records under <state>/prs name, the one it learned last, a file's
#                 dated by when it was written and a record's by its started_at; null when none
#                 names the PR or without the repo. It differs from head_sha once the PR has new
#                 commits since the review
#     skipped_by_user whether the user marked the review done without submitting it, with
#                 bin/whooper-skip, which leaves skipped-by-user in the run directory
#     removed_by_user whether the user took the review out of their lists with bin/whooper-remove,
#                 which leaves removed-by-user in the run directory; Whooper then does not retry it
#                 on its own
#   rounds      the last 50 rounds from <state>/rounds.jsonl, newest first, each {started_at,
#               ended_at, result, selected, reason}: result is done, poll_failed, or interrupted,
#               as in last_round, or skipped for a round whooper-run skipped while Whooper was
#               paused, whose ended_at is null; selected is how many items the round selected, 0
#               when it ended before selecting; reason says why it ended so, or is null: which poll
#               step failed, the cause reviews wait on and how many wait, or that Whooper is paused
#
# Times are local, in ISO 8601 with the offset. bin/whooper-show <run-id> --json prints one review
# in full.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
[[ $# == 1 && "$1" == --json ]] || { echo "usage: whooper-status --json" >&2; exit 1; }
eval "$("$root/lib/python" "$root/lib/whooper.py" env)"
exec "$root/lib/python" "$root/lib/whooper.py" status "$WHOOPER_STATE"
