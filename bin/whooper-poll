#!/usr/bin/env bash
# Lists the user's review work in <state>/poll/<UTC start time>.json and prints that path, where
# <state> is $XDG_STATE_HOME/whooper (default ~/.local/state/whooper).
#
# slackdump reads the ask channel through the user's Slack web login, from <state>/poll/cursor (the
# last 24 hours without one), paging to the end itself, and lib/whooper.py turns its dump into the
# channel's posts. The agent the config's [jobs] poll names judges which posts ask the user for a
# review, through its launcher agents/<agent>/poll, which gives it the posts in the prompt and no
# way to act. lib/whooper.py checks its answer against the posts, this script fetches the PRs they
# link, and lib/whooper.py combines them with <state>/poll/github.json from whooper-fetch. The
# cursor moves to this poll's start time only after the output is written. Read-only toward GitHub
# and Slack.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
eval "$("$root/lib/python" "$root/lib/whooper.py" env)"
poll="$WHOOPER_STATE/poll"
mkdir -p "$poll"
# One clock read for both, in a form BSD and GNU date share.
read -r started stamp <<<"$(date -u '+%s %Y%m%dT%H%M%SZ')"
if [[ -f "$poll/cursor" ]]; then
  oldest="$(<"$poll/cursor")"
else
  oldest="$((started - 86400))"
fi
work=""
agent_group="" agent_file=""
watchdog_pid=""
finished=false
# As in whooper-review: stops the run's process group, named by the file lib/whooper.py session writes its ID in, and
# everything the run started, with a SIGKILL to whatever is left 4 seconds after the TERM (lib/stop-group), or keeps a
# run that has not yet made its group from starting.
stop_group() {
  if [[ -n "$1" ]] && "$root/lib/stop-group" "$1"; then
    wait "$(cat "$1")" 2>/dev/null || true
  fi
}
# As in whooper-review: once the time limit passes, the watchdog marks the run timed out and stops it with stop_group, so
# a run that has not yet made its process group never starts, and a TERM to the watchdog stops its sleep too.
watchdog() {
  local me
  me="$(exec /bin/sh -c 'echo "$PPID"')"
  trap 'pkill -P "$me"; exit' TERM
  sleep "$1" &
  wait "$!" || exit 0
  : > "$work/timed-out"
  stop_group "$agent_file"
}
cleanup() {
  local status=$?
  # As in whooper-review, a process bash forked for a background command that runs this trap, as when it
  # cannot expand the command's words, exits at once, so only this script's own process stops the run and
  # removes the work folder.
  if [[ "$(exec /bin/sh -c 'echo "$PPID"')" != "$$" ]]; then
    exit "$status"
  fi
  # As in whooper-review, bash 3.2, macOS's /bin/bash, runs this with $? at 0 when set -u stops the script
  # on an unset variable. A poll that did not finish exits 1 then, so whooper-round does not go on to
  # select work as if it had written its output.
  if [[ "$finished" != true ]] && ((status == 0)); then
    status=1
  fi
  stop_group "$agent_file"
  # As in whooper-review, this stops each process this script started that is left by now, the watchdog
  # among them, since bash 3.2 can run the trap before watchdog_pid holds its process ID.
  pkill -P "$$" 2>/dev/null || true
  rm -rf "$work"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP
# As in whooper-review, the work folder comes after the traps, from a mktemp that ignores INT, TERM,
# and HUP, so no signal leaves it behind.
work="$(trap '' INT TERM HUP; mktemp -d)"

die() {
  echo "whooper-poll: $*" >&2
  exit 1
}

# slackdump reads from a day before the cursor, so the replies and edits that came since the cursor
# under older posts come along; lib/whooper.py keeps only what is new. It takes its start time in UTC.
from="$("$root/lib/python" -c 'import datetime, sys
print(datetime.datetime.fromtimestamp(int(sys.argv[1]) - 86400, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S"))' "$oldest")"
slackdump dump -workspace "$WHOOPER_SLACKDUMP_WORKSPACE" -files=false -time-from "$from" -o "$work/slack" \
  "$WHOOPER_ASK_CHANNEL" > "$work/slackdump.log" 2>&1 || die "slackdump failed: $(tail -n 3 "$work/slackdump.log")"
"$root/lib/python" "$root/lib/whooper.py" posts "$work/slack/$WHOOPER_ASK_CHANNEL.json" "$oldest" > "$work/posts.json"

# The prompt, the answer, and the run's transcript stay next to the poll's output as its record.
{
  "$root/lib/python" "$root/lib/whooper.py" prompt poll
  printf '\nuser_id: %s\n\nposts:\n\n' "$WHOOPER_SLACK_USER"
  cat "$work/posts.json"
} > "$poll/$stamp.prompt.md"
# As in whooper-review, the launcher starts in a session of its own, so the run and everything it
# starts form one process group that the time limit and the cleanup can stop. Without the limit, a
# request the network dropped held the loop for 93 minutes on Nov 24, 2026.
agent_file="$work/agent.group"
"$root/lib/python" "$root/lib/whooper.py" session "$agent_file" \
  "$root/agents/$WHOOPER_POLL_AGENT/poll" "$poll/$stamp.prompt.md" "$poll/$stamp.answer.json" "$poll/$stamp" < /dev/null &
agent_group=$!
watchdog "$((WHOOPER_POLL_TIMEOUT_MINUTES * 60))" &
watchdog_pid=$!
# set -e would stop the script at a failed wait, before it says where the run's errors are.
agent_exit=0
wait "$agent_group" || agent_exit=$?
kill "$watchdog_pid" 2>/dev/null || true
watchdog_pid=""
# As in whooper-review, this stops whatever the run left running and forgets its group file at once.
stop_group "$agent_file"
agent_file=""
[[ ! -e "$work/timed-out" ]] ||
  die "the $WHOOPER_POLL_AGENT poll run passed its $WHOOPER_POLL_TIMEOUT_MINUTES-minute limit; see $poll/$stamp.*"
(( agent_exit == 0 )) || die "the $WHOOPER_POLL_AGENT poll run failed; see $poll/$stamp.*"
"$root/lib/python" "$root/lib/whooper.py" check "$root/schemas/slack-asks.json" "$poll/$stamp.answer.json"
"$root/lib/python" "$root/lib/whooper.py" asks "$work/posts.json" "$poll/$stamp.answer.json" "$oldest" > "$work/asks.json"
# lib/whooper.py passed only plain URLs of PRs in the configured orgs that the asking post links.
jq -r '[.[].pr_urls[]] | unique[]' "$work/asks.json" | "$root/bin/whooper-prs" > "$work/slack-prs.json"

"$root/lib/python" "$root/lib/whooper.py" items "$poll/github.json" \
  "$work/asks.json" "$work/slack-prs.json" > "$poll/$stamp.json.tmp"
mv "$poll/$stamp.json.tmp" "$poll/$stamp.json"
echo "$started" > "$poll/cursor"
echo "$poll/$stamp.json"
finished=true
