#!/usr/bin/env bash
# Lists the user's review work in <state>/poll/<UTC start time>.json and prints that path, where
# <state> is $XDG_STATE_HOME/whooper (default ~/.local/state/whooper).
#
# slackdump reads the ask channel through the user's Slack web login, from <state>/poll/cursor (the
# last 24 hours without one), paging to the end itself, and lib/whooper.py turns its dump into the
# channel's posts. The agent the config's [jobs] poll names judges which posts ask the user for a
# review, through its launcher agents/<agent>/poll, which gives it the posts in the prompt and no
# way to act. lib/whooper.py checks its answer against the posts, this script fetches the PRs they
# link, and lib/whooper.py combines them with <state>/poll/github.json from whooper-fetch. The
# cursor moves to this poll's start time only after the output is written. Read-only toward GitHub
# and Slack.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
eval "$(python3 -I "$root/lib/whooper.py" env)"
poll="$WHOOPER_STATE/poll"
mkdir -p "$poll"
# One clock read for both, in a form BSD and GNU date share.
read -r started stamp <<<"$(date -u '+%s %Y%m%dT%H%M%SZ')"
if [[ -f "$poll/cursor" ]]; then
  oldest="$(<"$poll/cursor")"
else
  oldest="$((started - 86400))"
fi
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

die() {
  echo "whooper-poll: $*" >&2
  exit 1
}

# slackdump takes its start time in UTC.
from="$(python3 -I -c 'import datetime, sys
print(datetime.datetime.fromtimestamp(int(sys.argv[1]), datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S"))' "$oldest")"
slackdump dump -workspace "$WHOOPER_SLACKDUMP_WORKSPACE" -files=false -time-from "$from" -o "$work/slack" \
  "$WHOOPER_ASK_CHANNEL" > "$work/slackdump.log" 2>&1 || die "slackdump failed: $(tail -n 3 "$work/slackdump.log")"
python3 -I "$root/lib/whooper.py" posts "$work/slack/$WHOOPER_ASK_CHANNEL.json" "$oldest" > "$work/posts.json"

# The prompt, the answer, and the run's transcript stay next to the poll's output as its record.
{
  python3 -I "$root/lib/whooper.py" prompt poll
  printf '\nuser_id: %s\n\nposts:\n\n' "$WHOOPER_SLACK_USER"
  cat "$work/posts.json"
} > "$poll/$stamp.prompt.md"
"$root/agents/$WHOOPER_POLL_AGENT/poll" "$poll/$stamp.prompt.md" "$poll/$stamp.answer.json" "$poll/$stamp" ||
  die "the $WHOOPER_POLL_AGENT poll run failed; see $poll/$stamp.*"
python3 -I "$root/lib/whooper.py" check "$root/schemas/slack-asks.json" "$poll/$stamp.answer.json"
python3 -I "$root/lib/whooper.py" asks "$work/posts.json" "$poll/$stamp.answer.json" "$oldest" > "$work/asks.json"
# lib/whooper.py passed only plain URLs of PRs in the configured orgs that the asking post links.
jq -r '[.[].pr_urls[]] | unique[]' "$work/asks.json" | "$root/bin/whooper-prs" > "$work/slack-prs.json"

python3 -I "$root/lib/whooper.py" items "$poll/github.json" \
  "$work/asks.json" "$work/slack-prs.json" > "$poll/$stamp.json.tmp"
mv "$poll/$stamp.json.tmp" "$poll/$stamp.json"
echo "$started" > "$poll/cursor"
echo "$poll/$stamp.json"
