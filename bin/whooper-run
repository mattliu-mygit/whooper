#!/usr/bin/env bash
# Runs Whooper on the config's [schedule] until stopped. Each round is bin/whooper-round, which
# fetches, polls, selects, and reviews each selected item; nothing posts to GitHub or Slack.
#
# The first round starts at once and each later one interval_minutes after the last one ended; a
# time outside the configured hours and days moves to the next start. Before each wait, whooper-run
# writes the next round's Unix time to <state>/next-round, where <state> is $XDG_STATE_HOME/whooper
# (default ~/.local/state/whooper). While <state>/paused exists, which bin/whooper-pause creates and
# bin/whooper-resume deletes, it skips each round it comes to, logs that it did, and adds the skipped
# round to <state>/rounds.jsonl, the history bin/whooper-status prints, as whooper-round adds each
# round it runs. A pause does not survive a restart: whooper-run deletes <state>/paused when it
# starts. Only one copy runs at a time: whooper-run holds the lock <state>/run.lock, with its process
# ID in run.lock/pid, and refuses to start while another whooper-run holds it. Stop it with Ctrl-C,
# or with kill -- -$(cat <state>/run.lock/pid) when a shell started it in the background; either way
# the round it is running stops too.
#
# No set -e: a round that fails must not end the loop, and the next round tries again.
set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
eval "$("$root/lib/python" "$root/lib/whooper.py" env)"
lock="$WHOOPER_STATE/run.lock"
mkdir -p "$WHOOPER_STATE"

# Runs a command with its output going to a temporary file beside the file $1, then renames that
# file to $1, so a program watching the state folder never reads half a file.
save() {
  local file="$1"
  shift
  "$@" > "$file.tmp" && mv "$file.tmp" "$file"
}

# mkdir is atomic, so of two copies started at once only one gets the lock, as in whooper-review.
# A lock whose process is gone, or is now some other program, is stale and this run takes it over:
# a kill -9 or a restart leaves the lock behind, and its process ID can later belong to anything.
# An INT, TERM, or HUP never does: the traps come before the lock, and take makes the lock and
# writes its pid in a subshell that ignores those signals, so one that comes meanwhile stops this
# script only once the lock has its pid. The EXIT trap removes the lock only when its pid is this
# process's, so a copy refused below leaves the other copy's lock.
nap=""
trap '[[ "$(cat "$lock/pid" 2>/dev/null)" != "$$" ]] || rm -rf "$lock"; [[ -z "$nap" ]] || kill "$nap" 2>/dev/null || true' EXIT
trap 'exit 130' INT TERM HUP
take() { (trap '' INT TERM HUP; mkdir "$lock" 2>/dev/null && save "$lock/pid" echo "$$"); }
if ! take; then
  holder="$(cat "$lock/pid" 2>/dev/null || true)"
  if [[ -n "$holder" ]] && ps -o command= -p "$holder" 2>/dev/null | grep -q whooper-run; then
    echo "whooper-run: process $holder is already running Whooper; see $lock/pid" >&2
    exit 1
  fi
  rm -rf "$lock"
  if ! take; then
    echo "whooper-run: another copy took $lock first" >&2
    exit 1
  fi
fi
# A pause does not survive a restart: Prompting Time starts whooper-run each time it opens, and
# reopening it leaves Whooper running. Only the copy that holds the lock deletes the pause, so a
# second copy refused above leaves it.
rm -f "$WHOOPER_STATE/paused"

ended=""
while true; do
  # lib/whooper.py reads [schedule] each time, so a change applies from the next round.
  next="$("$root/lib/python" "$root/lib/whooper.py" next-round ${ended:+"$ended"})" || exit 1
  save "$WHOOPER_STATE/next-round" echo "$next"
  # sleep counts only time the computer is awake, so one long sleep would start the round late by
  # however long a laptop slept. Naps of at most a minute, each followed by a look at the clock,
  # start a round that came due during sleep within a minute of waking.
  while now="$(date +%s)" && ((now < next)); do
    # A nap in the background with wait lets a TERM from Prompting Time stop the loop at once.
    sleep "$((next - now < 60 ? next - now : 60))" &
    nap=$!
    wait "$nap"
  done

  # The round is due, so it is no longer next.
  rm -f "$WHOOPER_STATE/next-round"
  # A pause stops only the schedule: bin/whooper-round run by hand still runs a round.
  if [[ -e "$WHOOPER_STATE/paused" ]]; then
    echo "=== $(date '+%F %T') skipped this round: Whooper is paused; bin/whooper-resume resumes it"
    # A skipped round never ran, so it has no end.
    "$root/lib/python" "$root/lib/whooper.py" add-round "$WHOOPER_STATE" "$(jq -cn --argjson started "$(date +%s)" \
      '{started_at: $started, ended_at: null, result: "skipped", selected: 0, reason: "Whooper is paused"}')"
  else
    # In the foreground, so Ctrl-C and kill -- -<pid> reach the round too. A TERM sent to this
    # process alone takes effect only once the round ends, since bash runs a trap between commands.
    "$root/bin/whooper-round"
  fi
  ended="$(date +%s)"
done
