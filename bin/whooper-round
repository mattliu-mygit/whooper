#!/usr/bin/env bash
# Runs one round of Whooper now: whooper-fetch, whooper-poll, and whooper-select, then for each
# selected item a dry-run whooper-review, whooper-classify, whooper-post --print, and
# whooper-summary, and runs [schedule] notify as <notify> <title> <message> when that review
# finishes or fails. Nothing posts to GitHub or Slack. whooper-run runs it on the config's
# [schedule]; run by hand, it runs a round even while Whooper is paused.
#
# Only one round runs at a time: whooper-round holds the lock <state>/round.lock, with its process
# ID in round.lock/pid, where <state> is $XDG_STATE_HOME/whooper (default ~/.local/state/whooper),
# and exits 1 with "a round is already running" while another whooper-round holds it. While the
# round runs, round.lock/round.json holds when it started and the PR it is reviewing. When the round
# ends, done, failed, or stopped, it writes <state>/last-round.json, which bin/whooper-status reads.
# It exits 0 when the poll steps succeeded, whether or not each review did, and 1 when one failed.
#
# No set -e: a review that fails must not end the round, and the next item still gets its review.
set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
eval "$("$root/lib/python" "$root/lib/whooper.py" env)"
items="$WHOOPER_STATE/items"
lock="$WHOOPER_STATE/round.lock"
record="$lock/round.json"
mkdir -p "$items"

# Runs a command with its output going to a temporary file beside the file $1, then renames that
# file to $1, so a program watching the state folder never reads half a file.
save() {
  local file="$1"
  shift
  "$@" > "$file.tmp" && mv "$file.tmp" "$file"
}

notify() {
  if [[ -n "$WHOOPER_NOTIFY" ]]; then
    "$WHOOPER_NOTIFY" "$1" "$2" > /dev/null 2>&1 || echo "notify failed: $1"
  fi
}

# The same lock rule as whooper-run's: mkdir is atomic, so of two rounds started at once only one
# gets the lock, and a lock whose process is gone, or is now some other program, is stale and this
# round takes it over.
if ! mkdir "$lock" 2>/dev/null; then
  holder="$(cat "$lock/pid" 2>/dev/null || true)"
  if [[ -n "$holder" ]] && ps -o command= -p "$holder" 2>/dev/null | grep -q whooper-round; then
    echo "whooper-round: a round is already running, in process $holder; see $lock/pid" >&2
    exit 1
  fi
  rm -rf "$lock"
  if ! mkdir "$lock" 2>/dev/null; then
    echo "whooper-round: a round is already running; another copy took $lock first" >&2
    exit 1
  fi
fi
save "$lock/pid" echo "$$"
save "$record" jq -n --argjson started "$(date +%s)" '{started_at: $started, selected: null, reviewing: null, reviews: []}'
# However the round ends, round.json becomes last-round.json with the time and result, and a review
# still running is listed as interrupted.
result=interrupted
finish() {
  save "$WHOOPER_STATE/last-round.json" jq --argjson ended "$(date +%s)" --arg result "$result" \
    '{started_at, ended_at: $ended, result: $result, selected,
      reviews: (.reviews + if .reviewing then [{pr: .reviewing, outcome: "interrupted"}] else [] end)}' "$record"
  rm -rf "$lock"
}
trap finish EXIT
trap 'exit 130' INT TERM HUP

echo "=== $(date '+%F %T') poll"
if ! { "$root/bin/whooper-fetch" && "$root/bin/whooper-poll" && save "$items/selected.jsonl" "$root/bin/whooper-select"; }; then
  echo "a poll step failed; trying again next round"
  result=poll_failed
  exit 1
fi
selected="$(grep -c . "$items/selected.jsonl")"
echo "selected: $selected item(s)"
save "$record" jq --argjson selected "$selected" '.selected = $selected' "$record"
while IFS= read -r item <&3; do
  pr="$(jq -r '"\(.repo)#\(.pr)"' <<<"$item")"
  file="$items/$(jq -r '"\(.repo | sub("/"; "-"))-\(.pr)-\(.kind)"' <<<"$item").json"
  save "$file" printf '%s\n' "$item"
  echo "--- review $pr $(jq -r .kind <<<"$item")"
  save "$record" jq --arg pr "$pr" '.reviewing = $pr' "$record"
  if run="$("$root/bin/whooper-review" "$file" --dry-run < /dev/null)"; then
    "$root/bin/whooper-classify" "$run" < /dev/null
    "$root/bin/whooper-post" "$(basename "$run")" --print < /dev/null
    "$root/bin/whooper-summary" "$(basename "$run")" < /dev/null
    notify "Whooper reviewed $pr" "$(jq -r '"\(.approval.verdict | gsub("_"; " ")), \(.findings | length) finding(s). \(.approval.reason | .[0:200])"' "$run/findings.json")"
    outcome=reviewed
  else
    echo "review failed"
    notify "Whooper: $pr review failed" "See whooper-round's output."
    outcome=failed
  fi
  save "$record" jq --arg outcome "$outcome" '.reviews += [{pr: .reviewing, outcome: $outcome}] | .reviewing = null' "$record"
done 3< "$items/selected.jsonl"
result=done
