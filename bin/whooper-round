#!/usr/bin/env bash
# Runs one round of Whooper now: whooper-fetch, whooper-poll, and whooper-select, then for each
# selected item a dry-run whooper-review, whooper-classify, whooper-post --print, and
# whooper-summary, and runs [schedule] notify as <notify> <title> <message> when that review
# finishes or fails, unless bin/whooper-skip stopped it. Nothing posts to GitHub or Slack. whooper-run runs it on the config's
# [schedule]; run by hand, it runs a round even while Whooper is paused.
#
# When a review stops at a cause that stops every review, such as a setup script that cannot reach
# Docker (its failure.json, lib/whooper.py's failure_cause), the round starts none of its remaining
# reviews: each waits, with that cause, in a run directory of its own, and goes on the recheck list,
# so the next round reviews it again (lib/whooper.py's wait_review).
#
# Only one round runs at a time: whooper-round holds the lock <state>/round.lock, with its process
# ID in round.lock/pid, where <state> is $XDG_STATE_HOME/whooper (default ~/.local/state/whooper),
# and exits 1 with "a round is already running" while another whooper-round holds it. While the
# round runs, round.lock/round.json holds when it started and the PR it is reviewing. When the round
# ends, done, failed, or stopped, it writes <state>/last-round.json, which bin/whooper-status reads,
# and adds the round to <state>/rounds.jsonl, the history of the last 15 days' rounds and at least the
# last 50, with a reason: which poll step failed, the cause reviews wait on and how many wait, or null. It exits 0 when the poll
# steps succeeded, whether or not each review did, and 1 when one failed.
#
# No set -e: a review that fails must not end the round, and the next item still gets its review.
set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
eval "$("$root/lib/python" "$root/lib/whooper.py" env)"
items="$WHOOPER_STATE/items"
lock="$WHOOPER_STATE/round.lock"
record="$lock/round.json"
mkdir -p "$items" "$WHOOPER_STATE/locks"

# Runs a command with its output going to a temporary file beside the file $1, then renames that
# file to $1, so a program watching the state folder never reads half a file.
save() {
  local file="$1"
  shift
  "$@" > "$file.tmp" && mv "$file.tmp" "$file"
}

notify() {
  if [[ -n "$WHOOPER_NOTIFY" ]]; then
    "$WHOOPER_NOTIFY" "$1" "$2" > /dev/null 2>&1 || echo "notify failed: $1"
  fi
}

# However the round ends, round.json becomes last-round.json with the time and result, and a review
# still running is listed as interrupted. The history gets the round with the reason it ended so, or
# null, and 0 selected for a round that ended before it selected. Only the round whose process ID
# the lock holds does this: one refused the lock below, or stopped before it took it, leaves the
# lock and both files alone.
result=interrupted reason=""
finish() {
  [[ "$(cat "$lock/pid" 2>/dev/null)" == "$$" ]] || return
  save "$WHOOPER_STATE/last-round.json" jq --argjson ended "$(date +%s)" --arg result "$result" \
    '{started_at, ended_at: $ended, result: $result, selected,
      reviews: (.reviews + if .reviewing then [{pr: .reviewing, outcome: "interrupted"}] else [] end)}' "$record"
  "$root/lib/python" "$root/lib/whooper.py" add-round "$WHOOPER_STATE" "$(jq -c --arg reason "$reason" \
    '{started_at, ended_at, result, selected: (.selected // 0), reason: (if $reason == "" then null else $reason end)}' \
    "$WHOOPER_STATE/last-round.json")"
  rm -rf "$lock"
}
trap finish EXIT
trap 'exit 130' INT TERM HUP

# The same lock rule as whooper-run's: mkdir is atomic, so of two rounds started at once only one
# gets the lock, and a lock whose process is gone, or is now some other program, is stale and this
# round takes it over. As there, the traps come before the lock, and take makes the lock, writes
# round.json, and then writes the pid in a subshell that ignores INT, TERM, and HUP, so no such
# signal leaves the lock behind, and a round whose process ID the lock holds has the round.json that
# finish reads. And as there, a round holds flock on <state>/locks from before take until it holds
# the lock or refuses, so no round reads a lock another round is still making, and of two rounds
# that find the same stale lock only one takes it over.
take() {
  (trap '' INT TERM HUP; mkdir "$lock" 2>/dev/null &&
    save "$record" jq -n --argjson started "$(date +%s)" '{started_at: $started, selected: null, reviewing: null, reviews: []}' &&
    save "$lock/pid" echo "$$")
}
{
  "$root/lib/python" -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX)' || exit 1
  if ! take; then
    holder="$(cat "$lock/pid" 2>/dev/null || true)"
    if [[ -n "$holder" ]] && ps -o command= -p "$holder" 2>/dev/null | grep -q whooper-round; then
      echo "whooper-round: a round is already running, in process $holder; see $lock/pid" >&2
      exit 1
    fi
    rm -rf "$lock"
    if ! take; then
      echo "whooper-round: could not take over $lock" >&2
      exit 1
    fi
  fi
} 9< "$WHOOPER_STATE/locks" || exit 1

echo "=== $(date '+%F %T') poll"
# step names the poll step that runs, for the history's reason when it fails.
if ! { step="The GitHub fetch" && "$root/bin/whooper-fetch" && step="The Slack poll" && "$root/bin/whooper-poll" &&
  step="Selecting the work" && save "$items/selected.jsonl" "$root/bin/whooper-select"; }; then
  echo "a poll step failed; trying again next round"
  result=poll_failed reason="$step failed"
  exit 1
fi
selected="$(grep -c . "$items/selected.jsonl")"
echo "selected: $selected item(s)"
save "$record" jq --argjson selected "$selected" '.selected = $selected' "$record"
# The failure.json of the review that stopped at a cause that stops every review, once one has.
blocked="" waited=0
while IFS= read -r item <&3; do
  pr="$(jq -r '"\(.repo)#\(.pr)"' <<<"$item")"
  file="$items/$(jq -r '"\(.repo | sub("/"; "-"))-\(.pr)-\(.kind)"' <<<"$item").json"
  save "$file" printf '%s\n' "$item"
  if [[ -n "$blocked" ]]; then
    echo "--- $pr $(jq -r .kind <<<"$item") waits for the next round: $(jq -r .summary "$blocked")"
    "$root/lib/python" "$root/lib/whooper.py" wait "$WHOOPER_STATE" "$file" "$blocked"
    save "$record" jq --arg pr "$pr" '.reviews += [{pr: $pr, outcome: "waiting"}]' "$record"
    waited=$((waited + 1))
    continue
  fi
  echo "--- review $pr $(jq -r .kind <<<"$item")"
  save "$record" jq --arg pr "$pr" '.reviewing = $pr' "$record"
  if run="$("$root/bin/whooper-review" "$file" --dry-run < /dev/null)"; then
    "$root/bin/whooper-classify" "$run" < /dev/null
    "$root/bin/whooper-post" "$(basename "$run")" --print < /dev/null
    "$root/bin/whooper-summary" "$(basename "$run")" < /dev/null
    notify "Whooper reviewed $pr" "$(jq -r '"\(.approval.verdict | gsub("_"; " ")), \(.findings | length) finding(s). \(.approval.reason | .[0:200])"' "$run/findings.json")"
    outcome=reviewed
  elif [[ -n "$run" && -e "$run/skipped-by-user" ]]; then
    # bin/whooper-skip stopped the review, so the user knows; it counts as failed.
    echo "review stopped: skipped by the user"
    outcome=failed
  else
    echo "review failed"
    notify "Whooper: $pr review failed" "See whooper-round's output."
    outcome=failed
    # whooper-review prints its run directory once it has one, and saves there what stopped the review.
    if [[ -n "$run" ]] && jq -e '.scope == "all"' "$run/failure.json" > /dev/null 2>&1; then
      blocked="$run/failure.json"
    fi
  fi
  save "$record" jq --arg outcome "$outcome" '.reviews += [{pr: .reviewing, outcome: $outcome}] | .reviewing = null' "$record"
done 3< "$items/selected.jsonl"
result=done
if ((waited)); then
  reason="$(jq -r .summary "$blocked"), so $waited review(s) wait for the next round"
fi
