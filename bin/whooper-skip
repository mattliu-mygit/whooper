#!/usr/bin/env bash
# Marks a finished review run as skipped by the user, done without being submitted, or unmarks it:
#
#   whooper-skip <run-id> [--undo]
#
# The mark is the empty file skipped-by-user in the run's directory, <state>/runs/<run-id>/, where
# <state> is $XDG_STATE_HOME/whooper (default ~/.local/state/whooper), and --undo deletes it. While
# the mark is there, bin/whooper-status lists the review with skipped_by_user true and needs_you
# false, and bin/whooper-show gives skipped_by_user true. Nothing else changes: nothing posts to
# GitHub, and the drafts and records stay as they were, so the review can still be submitted. It
# prints what it did, and when the mark was already so, says that and changes nothing.
#
# It refuses a run ID that names no run directory and a review still running, which a live
# whooper-review holds the PR's lock for. Prompting Time runs it as the manifest's skip action,
# adding the run ID, and --undo after it; either order works.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
usage="usage: whooper-skip <run-id> [--undo]"
run_id="" undo=""
while (($#)); do
  case "$1" in
    --undo)
      [[ -z "$undo" ]] || { echo "$usage" >&2; exit 1; }
      undo=--undo
      ;;
    *)
      [[ -z "$run_id" ]] || { echo "$usage" >&2; exit 1; }
      run_id="$1"
      ;;
  esac
  shift
done
[[ -n "$run_id" ]] || { echo "$usage" >&2; exit 1; }
eval "$("$root/lib/python" "$root/lib/whooper.py" env)"
exec "$root/lib/python" "$root/lib/whooper.py" skip "$WHOOPER_STATE" "$run_id" ${undo:+"$undo"}
