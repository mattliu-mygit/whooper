#!/usr/bin/env bash
# Reviews one work item with a run of the agent the config's [jobs] review names, through its
# launcher agents/<agent>/review, and prints the run's directory, <state>/runs/<run-id>/, where
# <state> is $XDG_STATE_HOME/whooper (default ~/.local/state/whooper), as soon as it makes it, so
# a caller has it whether or not the review then finishes:
#
#   whooper-review <work-item.json> --dry-run [--as-of <ISO 8601 time with a zone>]
#
# The PR's repo must have a table in the config; for a repo without one, the review stops with the
# config's message before it takes the PR's lock. A repo without a clone in the cache fails the review
# once its run directory exists. Before the run starts, this script fetches with
# the user's login everything the run reads: the head and merge-base commits, checked out as the
# worktrees head/ and base/ in the run directory, and the PR's conversation as github.json. The
# diff between the two commits, the one the run reads, stays as diff.patch after the worktrees go,
# a plain patch whatever the user's git config says.
# With --as-of, github.json holds only what people could read before that time, for replaying a past
# review. Then the repo's setup script, if the config names one, prepares anything else the run
# needs, such as dependencies or databases (examples/setup.example.sh). The run itself has no
# GitHub login, and its launcher denies the Slack writes, so it can post nothing. Its findings.json
# must fit schemas/findings.json, and a run that passes [review] timeout_minutes is stopped. The run
# also writes its overview of the PR as overview.json. As soon as the run ends, an overview the run
# wrote inside findings.json instead, which the schema has no room for, leaves findings.json and moves
# to overview.json, unless the run wrote overview.json too, which then stays as it is. Then an
# overview.json that cannot be read, is not JSON, or breaks a rule of prompts/review.md's overview,
# such as lines outside the diff's hunks, moves to overview.invalid.json, with why there and on this
# script's error output (lib/whooper.py's read_overview). Whatever the overview, the review goes on as
# it would without one. bin/whooper-classify <run dir> then applies rule v1 to its findings.
#
# While it runs, this script holds the PR's lock, <state>/locks/<owner>-<repo>-<pr>/, with its
# process ID in pid and the run ID in run_id. On exit, finished or not, the repo's teardown script
# runs, the worktrees and PR lock go away, and a run that did not finish counts as a failure in its
# <state>/prs record. Once the run directory exists, a review that does not finish leaves why there
# as failure.txt: the reason this script prints when it stops the review, such as at the time limit,
# or else "the review was interrupted" after a signal such as Ctrl-C, or a line about an unexpected
# error after a command that failed. Beside it, failure.json holds the cause, {id, summary, scope},
# which lib/whooper.py's failure_cause names from the step the review stopped at and that step's
# error output, such as docker_unavailable, which stops every review, when the setup script could not
# reach Docker. Runs take --dry-run until a live run has a way to add :eyes: to the ask it takes.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
eval "$("$root/lib/python" "$root/lib/whooper.py" env)"
data="$WHOOPER_STATE"
usage="usage: whooper-review <work-item.json> --dry-run [--as-of <time>]"

# Once this review has its run directory, die also saves the reason there, so an ask about the
# failed review can read it, and the cause beside it in failure.json: what stopped the review, and
# whether that stops every review or only this PR's. lib/whooper.py names it from the step the
# review stopped at, $step, and the file holding that step's error output, $step_log, if any.
failure="" step="" step_log=""
save_failure() {
  echo "$1" > "$failure"
  "$root/lib/python" "$root/lib/whooper.py" cause "$run" "$step" ${step_log:+"$step_log"} || true
}
die() {
  echo "whooper-review: $*" >&2
  if [[ -n "$failure" ]]; then
    save_failure "$*"
  fi
  exit 1
}

item="" dry_run=false as_of=""
while (($#)); do
  case "$1" in
    --dry-run) dry_run=true ;;
    --as-of)
      (($# > 1)) || die "$usage"
      as_of="$2"
      shift
      ;;
    *)
      [[ -z "$item" ]] || die "$usage"
      item="$1"
      ;;
  esac
  shift
done
[[ -f "$item" ]] || die "$usage"
[[ "$dry_run" == true ]] || die "a live run has no way to add :eyes: to its ask yet; pass --dry-run"
if [[ -n "$as_of" ]] &&
  ! "$root/lib/python" -c 'import datetime, sys; assert datetime.datetime.fromisoformat(sys.argv[1]).tzinfo' "$as_of" 2>/dev/null; then
  die "--as-of takes an ISO 8601 time with a zone, such as 2031-01-02T03:04:05Z"
fi
IFS=$'\t' read -r repo pr head_sha base_ref kind source tagged reason < <(
  jq -r '[.repo, .pr, .head_sha, .base_ref, .kind, .source, (.slack.tagged_user | tostring), .reason] | @tsv' "$item")
# Sets WHOOPER_REPO_CLONE, WHOOPER_REPO_SETUP, and WHOOPER_REPO_TEARDOWN. For a repo the config does
# not list, the lookup prints the config's message and fails, and the review stops with that message,
# before it has a run directory for failure.txt: eval of the lookup's empty output would succeed, and
# the review would go on without the variables.
repo_env="$("$root/lib/python" "$root/lib/whooper.py" repo "$repo")" || exit 1
eval "$repo_env"
core="$WHOOPER_REPO_CLONE"
[[ "$kind" == first_review ]] || die "re-checks come in phase 4"
[[ "$pr" =~ ^[0-9]+$ && "$head_sha" =~ ^[0-9a-f]{40}$ ]] || die "$item needs a PR number and a full head_sha"
# base_ref names a branch, or for a replay the commit the base branch pointed at then. The check needs
# no repo, since the clone is checked only once the run directory exists.
git check-ref-format --branch "$base_ref" >/dev/null || die "base_ref $base_ref is not a branch or commit"

run_id="$(date -u +%Y%m%dT%H%M%SZ)-$pr"
run="$data/runs/$run_id"
lock="$data/locks/${repo/\//-}-$pr"

finished=false
# What failure.txt says when the review stops without die's reason: a command failed under set -e,
# unless the trap below records that a signal stopped the review.
stop_reason="the review stopped at an unexpected error; see whooper-review's error output"
work="" agent_group="" watchdog_pid=""
cleanup() {
  local status=$?
  # bash 3.2, macOS's /bin/bash, runs this with $? at 0 when set -u stops the script on an unset
  # variable. A review that did not finish exits 1 then, so whooper-round does not count it as
  # reviewed.
  if [[ "$finished" != true ]] && ((status == 0)); then
    status=1
  fi
  # Only the review whose process ID the lock holds has a run to clean up and a lock to remove. One
  # refused the lock below, or stopped before it took it, removes only its work folder.
  if [[ "$(cat "$lock/pid" 2>/dev/null)" != "$$" ]]; then
    rm -rf "$work"
    exit "$status"
  fi
  # This comes before the rest, so a second Ctrl-C during a slow teardown, which would end the
  # cleanup, cannot lose the reason.
  if [[ "$finished" != true && -n "$failure" && ! -e "$failure" ]]; then
    save_failure "$stop_reason" || true
  fi
  # The run and everything it started share one process group, so this also stops a server a
  # probe left running.
  if [[ -n "$agent_group" ]]; then
    kill -TERM -- "-$agent_group" 2>/dev/null || true
    wait "$agent_group" 2>/dev/null || true
  fi
  if [[ -n "$watchdog_pid" ]]; then
    kill "$watchdog_pid" 2>/dev/null || true
  fi
  # What the teardown script prints goes to the error output, so this script's output stays the run
  # directory alone.
  if [[ -n "$WHOOPER_REPO_TEARDOWN" && -n "${WHOOPER_RUN_ID:-}" ]]; then
    "$WHOOPER_REPO_TEARDOWN" >&2 || echo "whooper-review: $WHOOPER_REPO_TEARDOWN failed" >&2
  fi
  for tree in head base; do
    if [[ -d "$run/$tree" ]]; then
      git -C "$core" worktree remove --force "$run/$tree" || true
    fi
    git -C "$core" update-ref -d "refs/whooper/$run_id/$tree" 2>/dev/null || true
  done
  rm -rf "$work" "$run/tmp"
  if [[ "$finished" != true ]]; then
    "$root/lib/python" "$root/lib/whooper.py" record "$data" "$item" failed || true
  fi
  rm -rf "$lock"
  exit "$status"
}
trap cleanup EXIT
trap 'stop_reason="the review was interrupted" step=interrupted step_log=""; exit 130' INT TERM HUP

# The unfiltered GitHub data stays in work, outside the run directory the model reads. The traps come
# before the folder, so no signal leaves it behind: bash runs the INT, TERM, and HUP trap only once
# the command it is on ends, here once work names the folder, and mktemp, which makes the folder
# before it prints its name, runs in a subshell that ignores those signals, so it always prints it.
work="$(trap '' INT TERM HUP; mktemp -d)"

# A lock whose process is gone is stale, and this review takes it over. As in whooper-run, the traps
# come before the lock, take makes the lock and writes its pid in a subshell that ignores INT, TERM,
# and HUP, so no such signal leaves the lock behind, and a review holds flock on <state>/locks from
# before take until it holds the lock or refuses, so no review reads a lock another review is still
# making, and of two reviews that find the same stale lock only one takes it over.
mkdir -p "$data/locks"
take() { (trap '' INT TERM HUP; mkdir "$lock" 2>/dev/null && echo "$$" > "$lock/pid"); }
{
  "$root/lib/python" -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX)'
  if ! take; then
    holder="$(cat "$lock/pid" 2>/dev/null || true)"
    if [[ -n "$holder" ]] && kill -0 "$holder" 2>/dev/null; then
      die "process $holder is already reviewing $repo#$pr"
    fi
    rm -rf "$lock"
    take || die "could not take over $lock"
  fi
} 9< "$data/locks"
# The lock names the run, so whooper-ask refuses an ask about this review, and not about an earlier
# review of the PR, while this script runs.
echo "$run_id" > "$lock/run_id"

mkdir -p "$run/tmp"
# whooper-round reads why a review that fails stopped from its run directory.
echo "$run"
failure="$run/failure.txt"
"$root/lib/python" "$root/lib/whooper.py" record "$data" "$item" running

# Checked only now, so a review of a repo without a clone leaves its run directory and failure, which
# Prompting Time shows, and counts as a failure in its record.
step=clone
[[ -d "$core/.git" ]] || die "no clone of $repo at $core; see README.md"
# The fetch is the review's first use of the user's GitHub login, so its error output shows when gh
# is signed out. That output still goes to this script's, and a failed fetch stops the review as any
# failed command does.
step=fetch step_log="$work/fetch.log"
fetch_exit=0
git -C "$core" fetch --quiet --no-write-fetch-head origin \
  "$head_sha:refs/whooper/$run_id/head" "$base_ref:refs/whooper/$run_id/base" 2> "$step_log" || fetch_exit=$?
cat "$step_log" >&2
((fetch_exit == 0)) || exit "$fetch_exit"
step=prepare step_log=""
merge_base="$(git -C "$core" merge-base "refs/whooper/$run_id/head" "refs/whooper/$run_id/base")"
# Checking out both trees fetches every file in them, so the run can read both without a login.
git -C "$core" worktree add --quiet --detach "$run/head" "$head_sha"
git -C "$core" worktree add --quiet --detach "$run/base" "$merge_base"
# The worktrees go when the review ends, so the diff the run reads stays as diff.patch, for showing a
# past review and for asks about it. It runs in the head worktree, as the run's git diff does, because
# git applies the .gitattributes it finds there: a file marked -diff shows as binary. The flags keep
# it a plain patch whatever the user's git config says: no external diff tool, textconv filter, or
# color, a/ and b/ before the paths, and a submodule's commit lines rather than its log. whooper-show
# rebuilds the diff of a run from before this file with the same flags, lib/whooper.py's PLAIN_DIFF.
git -C "$run/head" diff --no-ext-diff --no-textconv --no-color --src-prefix=a/ --dst-prefix=b/ --submodule=short \
  "$merge_base" HEAD > "$run/diff.patch"
# skills holds a content hash of every skill the run can load, so a finding traces to the skill version behind it.
jq --arg run_id "$run_id" --arg merge_base "$merge_base" --arg as_of "$as_of" --arg agent "$WHOOPER_REVIEW_AGENT" \
  --argjson skills "$("$root/lib/python" "$root/lib/whooper.py" skills "$HOME/.claude/skills")" \
  '. + {run_id: $run_id, merge_base: $merge_base, as_of: (if $as_of == "" then null else $as_of end), dry_run: true,
        agent: $agent, skills: $skills}' \
  "$item" > "$run/run.json"

if gh api graphql -F query=@"$root/queries/conversation.graphql" \
  -f owner="${repo%/*}" -f name="${repo#*/}" -F number="$pr" > "$work/conversation.json" &&
  "$root/lib/python" "$root/lib/whooper.py" conversation "$work/conversation.json" ${as_of:+"$as_of"} > "$work/github.json"; then
  mv "$work/github.json" "$run/github.json"
  github="$run/github.json${as_of:+, which holds only what existed before $as_of}"
else
  echo "whooper-review: the GitHub fetch failed, so no finding of this run can auto-post" >&2
  github="missing, because the GitHub fetch failed"
fi

# The repo's setup script gets the run's paths and changed files, may append KEY=value lines for
# the run's environment to WHOOPER_SETUP_ENV, and prints what the run can use for the prompt.
# Exporting the paths here also gives them to the teardown script.
git -C "$core" diff --name-only "$merge_base" "$head_sha" > "$work/changed.txt"
: > "$work/setup.env"
export WHOOPER_RUN_ID="$run_id" WHOOPER_RUN="$run" WHOOPER_HEAD="$run/head" WHOOPER_BASE="$run/base" \
  WHOOPER_CHANGED="$work/changed.txt" WHOOPER_SETUP_ENV="$work/setup.env"
setup="none"
if [[ -n "$WHOOPER_REPO_SETUP" ]]; then
  # The script's error output still goes to this script's, once the script ends. When the script fails,
  # it names the cause, such as Docker not running, and its last line ends the reason.
  step=setup step_log="$work/setup.log"
  setup_exit=0
  setup="$("$WHOOPER_REPO_SETUP" 2> "$step_log")" || setup_exit=$?
  cat "$step_log" >&2
  ((setup_exit == 0)) ||
    die "$WHOOPER_REPO_SETUP failed$(awk 'NF { line = $0 } END { if (line != "") print ": " line }' "$step_log")"
  set -a
  source "$work/setup.env"
  set +a
fi
step=review step_log=""

untagged=""
if [[ "$source" == slack_ask && "$tagged" == false ]]; then
  untagged="
- The work came from an untagged team ask: decide first whether the PR is small or mechanical."
fi
# The prompt stays in the run directory as a record of what the run was told.
{
  "$root/lib/python" "$root/lib/whooper.py" prompt review "$repo" "$WHOOPER_REVIEW_AGENT"
  cat <<EOF

## This run

- Pull request: https://github.com/$repo/pull/$pr, base $base_ref. Why it is $WHOOPER_GITHUB_LOGIN's work: $reason$untagged
- Head: $head_sha, checked out in $run/head, the working directory.
- Merge base: $merge_base, checked out in $run/base.
- Run directory: $run. Write log.md and overview.json there.
- github.json: $github
- Repository setup: $setup
EOF
} > "$run/prompt.md"

# GitHub refuses the run: gh sends the token "disabled", and git's credential helper (gh) hands git
# the same. The launcher starts in a session of its own, so the run and everything it starts form
# one process group that the time limit and the cleanup can stop, and none of it reads the terminal.
(
  cd "$run/head"
  exec env GH_TOKEN=disabled GIT_SSH_COMMAND=false GIT_TERMINAL_PROMPT=0 TMPDIR="$run/tmp" \
    "$root/lib/python" -c 'import os, sys; os.setsid(); os.execv(sys.argv[1], sys.argv[1:])' \
    "$root/agents/$WHOOPER_REVIEW_AGENT/review" "$run/prompt.md" < /dev/null
) &
# Waiting on a background run lets an interrupt reach the cleanup at once.
agent_group=$!
"$root/lib/python" -c 'import os, signal, sys, time
time.sleep(float(sys.argv[1]))
open(sys.argv[2], "w").close()
os.killpg(int(sys.argv[3]), signal.SIGTERM)' "$((WHOOPER_REVIEW_TIMEOUT_MINUTES * 60))" "$work/timed-out" "$agent_group" &
watchdog_pid=$!
# set -e would stop the script at a failed wait, before it says where the run's errors are.
agent_exit=0
wait "$agent_group" || agent_exit=$?
kill "$watchdog_pid" 2>/dev/null || true
watchdog_pid=""

# The overview is checked as soon as the run ends, even one past its time limit, after an overview the
# run wrote inside findings.json leaves that file, so it cannot fail the findings' check below.
# Whatever the check finds, and even if it fails, the review goes on as it would without an overview.
"$root/lib/python" "$root/lib/whooper.py" overview "$run" || true

# Each check names its own step, which failure.json names the cause by.
step=time-limit
[[ ! -e "$work/timed-out" ]] ||
  die "the review run passed its $WHOOPER_REVIEW_TIMEOUT_MINUTES-minute limit; see $run/stderr.log and the transcript in $run"
step=findings
[[ -s "$run/findings.json" ]] ||
  die "the review run exited $agent_exit without findings; see $run/stderr.log and the transcript in $run"
# A finding that does not fit the schema would break classify, post, and the summary later.
"$root/lib/python" "$root/lib/whooper.py" check "$root/schemas/findings.json" "$run/findings.json" ||
  { mv "$run/findings.json" "$run/findings.invalid.json"; die "the review run's findings.json does not fit the schema"; }
[[ -f "$run/log.md" ]] || echo "whooper-review: the run wrote no log.md" >&2
finished=true
