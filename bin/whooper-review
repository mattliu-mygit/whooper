#!/usr/bin/env bash
# Reviews one work item with a run of the agent the config's [jobs] review names, through its
# launcher agents/<agent>/review, and prints the run's directory, <state>/runs/<run-id>/, where
# <state> is $XDG_STATE_HOME/whooper (default ~/.local/state/whooper), as soon as it makes it, so
# a caller has it whether or not the review then finishes:
#
#   whooper-review <work-item.json> --dry-run [--as-of <ISO 8601 time with a zone>]
#
# The PR's repo must have a table in the config; for a repo without one, the review stops with the
# config's message before it takes the PR's lock. A repo without a clone in the cache fails the review
# once its run directory exists. Before the run starts, this script fetches with
# the user's login everything the run reads: the head and merge-base commits, checked out as the
# worktrees head/ and base/ in the run directory, and the PR's conversation as github.json. The
# diff between the two commits, the one the run reads, stays as diff.patch after the worktrees go,
# a plain patch whatever the user's git config says.
# With --as-of, github.json holds only what people could read before that time, for replaying a past
# review. Then the repo's setup script, if the config names one, prepares anything else the run
# needs, such as dependencies or databases (examples/setup.example.sh). Then a step of at most 10
# minutes saves test_gaps.json, which of the lines the diff adds to Go, JavaScript, and TypeScript code
# no test ran, from one go test of the changed packages with coverage and one run of each changed Node
# package's Vitest or Jest tests with coverage (lib/whooper.py's test_gaps). The run may read the file,
# and may change it, so the copy from before the run replaces it once the run ends. The run itself has no
# GitHub login, and its launcher denies the Slack writes, so it can post nothing. Its findings.json
# must fit schemas/findings.json, and a run that passes [review] timeout_minutes is stopped. The run
# also writes its overview of the PR as overview.json. As soon as the run ends, an overview the run
# wrote inside findings.json instead, which the schema has no room for, leaves findings.json and moves
# to overview.json, unless the run wrote overview.json too, which then stays as it is. Then an
# overview.json that cannot be read, is not JSON, or breaks a rule of prompts/review.md's overview,
# such as lines outside the diff's hunks, moves to overview.invalid.json, with why there and on this
# script's error output (lib/whooper.py's read_overview). Whatever the overview, the review goes on as
# it would without one. Then, before the worktrees go, a step of at most 2 minutes saves
# connections.json, how the code the diff changes connects: the declarations it adds, changes, or
# removes, the code that calls them, one level up, and how each link was found, by gopls for Go files,
# by the TypeScript a file's package installed for JavaScript and TypeScript files, and by name search for
# the rest (lib/whooper.py's connections). Then, when the run chose example inputs
# for Go functions the PR changes, which it wrote as examples.json beside its test, whooper_examples_test.go,
# and which move to examples.request.json as soon as it ends, a step of at most 5 minutes runs the test once
# at the head and twice at the merge base, without the run's edits, and saves what it printed as
# examples.json (lib/whooper.py's examples). Then a step of at most 15 minutes has gremlins change each changed Go line
# tests ran, one small change at a time, and adds to test_gaps.json which lines survived, the tests still passing, and
# which were caught (lib/whooper.py's mutation). Whatever each step finds, and even if it fails, the review goes
# on as it would without its file. bin/whooper-classify <run dir> then applies rule v1 to its findings.
#
# While it runs, this script holds the PR's lock, <state>/locks/<owner>-<repo>-<pr>/, with its
# process ID in pid and the run ID in run_id. On exit, a run that did not finish first counts as a
# failure in its <state>/prs record; then, finished or not, the repo's teardown script runs, and the
# worktrees and PR lock go away. Once the run directory exists, a review that does not finish leaves why there
# as failure.txt: the reason this script prints when it stops the review, such as at the time limit,
# or else "the review was interrupted" after a signal such as Ctrl-C, or a line about an unexpected
# error after a command that failed. Beside it, failure.json holds the cause, {id, summary, scope},
# which lib/whooper.py's failure_cause names from the step the review stopped at and that step's
# error output, such as docker_unavailable, which stops every review, when the setup script could not
# reach Docker. Runs take --dry-run until a live run has a way to add :eyes: to the ask it takes.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
eval "$("$root/lib/python" "$root/lib/whooper.py" env)"
# With a job on claude, refuse a Claude Code older than 2.1.295 (lib/whooper.py's check_claude).
"$root/lib/python" "$root/lib/whooper.py" claude-version || exit 1
data="$WHOOPER_STATE"
usage="usage: whooper-review <work-item.json> --dry-run [--as-of <time>]"
# git takes an external diff tool from GIT_EXTERNAL_DIFF, and how many unchanged lines go around each
# change from GIT_DIFF_OPTS, whatever its config says, and GIT_DIFF_OPTS outranks even --unified, so
# neither diff.patch's arguments nor the run's config entries below could pin them. This script and
# everything it starts, diff.patch's git diff, every step, and the run, go without them.
unset GIT_EXTERNAL_DIFF GIT_DIFF_OPTS

# Once this review has its run directory, die also saves the reason there, so an ask about the
# failed review can read it, and the cause beside it in failure.json: what stopped the review, and
# whether that stops every review or only this PR's. lib/whooper.py names it from the step the
# review stopped at, $step, and the file holding that step's error output, $step_log, if any.
failure="" step="" step_log=""
save_failure() {
  echo "$1" > "$failure"
  "$root/lib/python" "$root/lib/whooper.py" cause "$run" "$step" ${step_log:+"$step_log"} || true
}
die() {
  echo "whooper-review: $*" >&2
  if [[ -n "$failure" ]]; then
    save_failure "$*"
  fi
  exit 1
}

item="" dry_run=false as_of=""
while (($#)); do
  case "$1" in
    --dry-run) dry_run=true ;;
    --as-of)
      (($# > 1)) || die "$usage"
      as_of="$2"
      shift
      ;;
    *)
      [[ -z "$item" ]] || die "$usage"
      item="$1"
      ;;
  esac
  shift
done
[[ -f "$item" ]] || die "$usage"
[[ "$dry_run" == true ]] || die "a live run has no way to add :eyes: to its ask yet; pass --dry-run"
if [[ -n "$as_of" ]] &&
  ! "$root/lib/python" -c 'import datetime, sys; assert datetime.datetime.fromisoformat(sys.argv[1]).tzinfo' "$as_of" 2>/dev/null; then
  die "--as-of takes an ISO 8601 time with a zone, such as 2031-01-02T03:04:05Z"
fi
IFS=$'\t' read -r repo pr head_sha base_ref kind source tagged reason < <(
  jq -r '[.repo, .pr, .head_sha, .base_ref, .kind, .source, (.slack.tagged_user | tostring), .reason] | @tsv' "$item")
# Sets WHOOPER_REPO_CLONE, WHOOPER_REPO_SETUP, and WHOOPER_REPO_TEARDOWN. For a repo the config does
# not list, the lookup prints the config's message and fails, and the review stops with that message,
# before it has a run directory for failure.txt: eval of the lookup's empty output would succeed, and
# the review would go on without the variables.
repo_env="$("$root/lib/python" "$root/lib/whooper.py" repo "$repo")" || exit 1
eval "$repo_env"
core="$WHOOPER_REPO_CLONE"
[[ "$kind" == first_review ]] || die "re-checks come in phase 4"
[[ "$pr" =~ ^[0-9]+$ && "$head_sha" =~ ^[0-9a-f]{40}$ ]] || die "$item needs a PR number and a full head_sha"
# base_ref names a branch, or for a replay the commit the base branch pointed at then. The check needs
# no repo, since the clone is checked only once the run directory exists.
git check-ref-format --branch "$base_ref" >/dev/null || die "base_ref $base_ref is not a branch or commit"

run_id="$(date -u +%Y%m%dT%H%M%SZ)-$pr"
run="$data/runs/$run_id"
lock="$data/locks/${repo/\//-}-$pr"

finished=false
# What failure.txt says when the review stops without die's reason: a command failed under set -e,
# unless the trap below records that a signal stopped the review.
stop_reason="the review stopped at an unexpected error; see whooper-review's error output"
work="" agent_group="" agent_file="" watchdog_pid="" step_file="" setup_file="" teardown_file=""
# Stops the run or a step, which lib/whooper.py session starts in a process group of its own, named by the file $1, where
# session writes the group's ID once it has made the group, and everything it started (lib/stop-group): a TERM, then a
# SIGKILL to whatever is left 4 seconds later. While the file is missing, as when this script stops the moment it starts
# the run, lib/stop-group makes the file instead, and session, finding it, or no work folder for it once the cleanup
# removes that, exits without starting the run: however the two meet, the run stops with the cleanup or never starts.
stop_group() {
  if [[ -n "$1" ]] && "$root/lib/stop-group" "$1"; then
    wait "$(cat "$1")" 2>/dev/null || true
  fi
}
# The run's time limit, which this script starts in the background as watchdog <seconds> &: once the limit passes, the
# watchdog marks the run timed out and stops it with stop_group, as the cleanup does, so a run that has not yet made its
# process group by then never starts. It waits in a sleep, which its TERM trap stops too, so the TERM this script sends
# it once the run ends leaves no sleep behind holding this script's output open. bash 3.2 has no BASHPID, so, as in the
# cleanup, the watchdog's process ID comes from a sh it starts with exec.
watchdog() {
  local me
  me="$(exec /bin/sh -c 'echo "$PPID"')"
  trap 'pkill -P "$me"; exit' TERM
  sleep "$1" &
  wait "$!" || exit 0
  : > "$work/timed-out"
  stop_group "$agent_file"
}
# Once the review stops, a further INT, TERM, or HUP only stops the teardown script, if it runs, so it cannot cut the
# cleanup short, as the TERM the round sends when it stops would when the cleanup of a review that ended had begun.
# The INT, TERM, and HUP trap calls this first of all, so a second signal right after the first finds it set.
stopping() {
  trap 'stop_group "$teardown_file"' INT TERM HUP
}
cleanup() {
  local status=$?
  stopping
  # bash also runs this trap in a process it forked for a background command, when that process cannot
  # expand the command's words, as under set -u, and $$ there is still this script's process ID, so that
  # process would pass the lock check below and clean up the review from under this one. Only this
  # script's own process cleans up; a forked one exits at once. bash 3.2 has no BASHPID, so the ID of the
  # process that runs this comes from a sh it starts with exec, whose parent it is.
  if [[ "$(exec /bin/sh -c 'echo "$PPID"')" != "$$" ]]; then
    exit "$status"
  fi
  # bash 3.2, macOS's /bin/bash, runs this with $? at 0 when set -u stops the script on an unset
  # variable. A review that did not finish exits 1 then, so whooper-round does not count it as
  # reviewed.
  if [[ "$finished" != true ]] && ((status == 0)); then
    status=1
  fi
  # Only the review whose process ID the lock holds has a run to clean up and a lock to remove. One
  # refused the lock below, or stopped before it took it, removes only its work folder.
  if [[ "$(cat "$lock/pid" 2>/dev/null)" != "$$" ]]; then
    rm -rf "$work"
    exit "$status"
  fi
  # These come before the rest, so the reason is saved, and the record counts the failure, even when the
  # cleanup is cut short, as by the SIGKILL the round sends 4 seconds after its TERM (stop_group).
  if [[ "$finished" != true ]]; then
    if [[ -n "$failure" && ! -e "$failure" ]]; then
      save_failure "$stop_reason" || true
    fi
    "$root/lib/python" "$root/lib/whooper.py" record "$data" "$item" failed || true
  fi
  # The run, while it runs, a step, and the setup script, while one runs, each with everything it started.
  stop_group "$agent_file"
  stop_group "$step_file"
  stop_group "$setup_file"
  # bash 3.2 can run the INT, TERM, and HUP trap between watchdog ... & and the line after it, which
  # records watchdog_pid, so this stops each process this script started that is left by now, the
  # watchdog among them, rather than the one watchdog_pid names.
  pkill -P "$$" 2>/dev/null || true
  # What the teardown script prints goes to the error output, so this script's output stays the run
  # directory alone. It runs in a session of its own, as the setup script does, and this waits for it
  # in the background, so a stop that comes meanwhile, which the INT, TERM, and HUP trap passes on to
  # it (stopping), stops it and everything it started at once (stop_group), and the cleanup goes on.
  if [[ -n "$WHOOPER_REPO_TEARDOWN" && -n "${WHOOPER_RUN_ID:-}" ]]; then
    teardown_file="$work/teardown.group"
    "$root/lib/python" "$root/lib/whooper.py" session "$teardown_file" "$WHOOPER_REPO_TEARDOWN" < /dev/null >&2 &
    wait "$!" || echo "whooper-review: $WHOOPER_REPO_TEARDOWN failed" >&2
    stop_group "$teardown_file"
    teardown_file=""
  fi
  for tree in head base; do
    if [[ -d "$run/$tree" ]]; then
      git -C "$core" worktree remove --force "$run/$tree" || true
    fi
    git -C "$core" update-ref -d "refs/whooper/$run_id/$tree" 2>/dev/null || true
  done
  rm -rf "$work" "$run/tmp"
  rm -rf "$lock"
  exit "$status"
}
trap cleanup EXIT
trap 'stopping; stop_reason="the review was interrupted" step=interrupted step_log=""; exit 130' INT TERM HUP

# The unfiltered GitHub data stays in work, outside the run directory the model reads. The traps come
# before the folder, so no signal leaves it behind: bash runs the INT, TERM, and HUP trap only once
# the command it is on ends, here once work names the folder, and mktemp, which makes the folder
# before it prints its name, runs in a subshell that ignores those signals, so it always prints it.
work="$(trap '' INT TERM HUP; mktemp -d)"

# A lock whose process is gone, or is now some other program, is stale, and this review takes it over.
# As in whooper-run, the traps come before the lock, take makes the lock and writes its pid in a
# subshell that ignores INT, TERM, and HUP, so no such signal leaves the lock behind, and a review
# holds flock on <state>/locks from before take until it holds the lock or refuses, so no review reads
# a lock another review is still making, and of two reviews that find the same stale lock only one
# takes it over.
mkdir -p "$data/locks"
take() { (trap '' INT TERM HUP; mkdir "$lock" 2>/dev/null && echo "$$" > "$lock/pid"); }
{
  "$root/lib/python" -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX)'
  if ! take; then
    holder="$(cat "$lock/pid" 2>/dev/null || true)"
    if [[ -n "$holder" ]] && ps -o command= -p "$holder" 2>/dev/null | grep -q whooper-review; then
      die "process $holder is already reviewing $repo#$pr"
    fi
    rm -rf "$lock"
    take || die "could not take over $lock"
  fi
} 9< "$data/locks"
# The lock names the run, so whooper-ask refuses an ask about this review, and not about an earlier
# review of the PR, while this script runs.
echo "$run_id" > "$lock/run_id"

mkdir -p "$run/tmp"
# whooper-round reads why a review that fails stopped from its run directory.
echo "$run"
failure="$run/failure.txt"
"$root/lib/python" "$root/lib/whooper.py" record "$data" "$item" running

# Checked only now, so a review of a repo without a clone leaves its run directory and failure, which
# Prompting Time shows, and counts as a failure in its record.
step=clone
[[ -d "$core/.git" ]] || die "no clone of $repo at $core; see README.md"
# The fetch is the review's first use of the user's GitHub login, so its error output shows when gh
# is signed out. That output still goes to this script's, and a failed fetch stops the review as any
# failed command does.
step=fetch step_log="$work/fetch.log"
fetch_exit=0
git -C "$core" fetch --quiet --no-write-fetch-head origin \
  "$head_sha:refs/whooper/$run_id/head" "$base_ref:refs/whooper/$run_id/base" 2> "$step_log" || fetch_exit=$?
cat "$step_log" >&2
((fetch_exit == 0)) || exit "$fetch_exit"
step=prepare step_log=""
merge_base="$(git -C "$core" merge-base "refs/whooper/$run_id/head" "refs/whooper/$run_id/base")"
# Checking out both trees fetches every file in them, so the run can read both without a login.
git -C "$core" worktree add --quiet --detach "$run/head" "$head_sha"
git -C "$core" worktree add --quiet --detach "$run/base" "$merge_base"
# The worktrees go when the review ends, so the diff the run reads stays as diff.patch, for showing a
# past review and for asks about it. It runs in the head worktree, as the run's git diff does, because
# git applies the .gitattributes it finds there: a file marked -diff shows as binary. The arguments
# keep it a plain patch, as git's defaults print it whatever the user's git config says:
#   - no external diff tool, textconv filter, or color, a/ and b/ before the paths, and a submodule's
#     commit lines rather than its log;
#   - hunks of 3 unchanged lines around each change, and a new one wherever more than 6 unchanged lines
#     separate two changes, found by the myers algorithm with the indent heuristic, and a blank line of
#     context printed with its leading space;
#   - renames found but not copies, among at most 1,000 files, and no order file;
#   - paths with unusual characters quoted, each file up to 512 MiB compared as text, and no attributes
#     from the user's attributes file, such as a hunk-header pattern, so only the repo's .gitattributes
#     count;
#   - each changed submodule shown, unless the repo's .gitmodules or the user's config says to ignore
#     that one: the run's config entries below cannot override that, as --ignore-submodules would, so
#     diff.patch keeps it too;
#   - object names of at least 12 digits. git's default, core.abbrev=auto, sizes names by how many
#     objects the clone holds, so they would grow as the cache's clone does; no two objects in a clone
#     share 12 digits in practice, so those stay put, and they stay as short as the names in the run's
#     other git output, which its environment below gives 12 digits too.
# The settings git diff has no flag for go before it with -c. whooper-show rebuilds the diff of a run
# from before this file with the same arguments, lib/whooper.py's PLAIN_DIFF.
git -C "$run/head" -c diff.suppressBlankEmpty=false -c core.quotePath=true -c core.bigFileThreshold=512m \
  -c core.attributesFile=/dev/null -c diff.ignoreSubmodules=none diff --no-ext-diff --no-textconv --no-color \
  --src-prefix=a/ --dst-prefix=b/ --submodule=short --unified=3 --inter-hunk-context=0 --diff-algorithm=myers \
  --indent-heuristic --find-renames -l1000 -O/dev/null --abbrev=12 "$merge_base" HEAD > "$run/diff.patch"
# skills holds a content hash of every skill the run can load, so a finding traces to the skill version behind it.
jq --arg run_id "$run_id" --arg merge_base "$merge_base" --arg as_of "$as_of" --arg agent "$WHOOPER_REVIEW_AGENT" \
  --argjson skills "$("$root/lib/python" "$root/lib/whooper.py" skills "$HOME/.claude/skills")" \
  '. + {run_id: $run_id, merge_base: $merge_base, as_of: (if $as_of == "" then null else $as_of end), dry_run: true,
        agent: $agent, skills: $skills}' \
  "$item" > "$run/run.json"

if gh api graphql -F query=@"$root/queries/conversation.graphql" \
  -f owner="${repo%/*}" -f name="${repo#*/}" -F number="$pr" > "$work/conversation.json" &&
  "$root/lib/python" "$root/lib/whooper.py" conversation "$work/conversation.json" ${as_of:+"$as_of"} > "$work/github.json"; then
  mv "$work/github.json" "$run/github.json"
  github="$run/github.json${as_of:+, which holds only what existed before $as_of}"
else
  echo "whooper-review: the GitHub fetch failed, so no finding of this run can auto-post" >&2
  github="missing, because the GitHub fetch failed"
fi

# The repo's setup script gets the run's paths and changed files, may append KEY=value lines for
# the run's environment to WHOOPER_SETUP_ENV, and prints what the run can use for the prompt.
# Exporting the paths here also gives them to the teardown script. The list of changed files takes
# those of diff.patch's settings that change which files git lists and how: a moved file listed by
# its new path, among at most 1,000 files, no order file, quoted paths, and each changed submodule.
git -C "$core" -c core.quotePath=true -c diff.ignoreSubmodules=none diff --name-only --find-renames -l1000 -O/dev/null \
  "$merge_base" "$head_sha" > "$work/changed.txt"
: > "$work/setup.env"
export WHOOPER_RUN_ID="$run_id" WHOOPER_RUN="$run" WHOOPER_HEAD="$run/head" WHOOPER_BASE="$run/base" \
  WHOOPER_CHANGED="$work/changed.txt" WHOOPER_SETUP_ENV="$work/setup.env"
setup="none"
if [[ -n "$WHOOPER_REPO_SETUP" ]]; then
  # The script runs in a session of its own (lib/whooper.py session), as the run does, and this waits for
  # it in the background, so an interrupt reaches the cleanup at once, and the cleanup stops the script
  # and everything it started (stop_group). Once it ends, this forgets setup.group without stopping what
  # the script left running, such as a database the run uses, which the teardown script removes. What it
  # prints goes to setup.out, and its error output still goes to this script's, once the script ends.
  # When the script fails, it names the cause, such as Docker not running, and its last line ends the
  # reason.
  step=setup step_log="$work/setup.log"
  setup_file="$work/setup.group"
  "$root/lib/python" "$root/lib/whooper.py" session "$setup_file" "$WHOOPER_REPO_SETUP" \
    < /dev/null > "$work/setup.out" 2> "$step_log" &
  setup_exit=0
  wait "$!" || setup_exit=$?
  setup_file=""
  setup="$(cat "$work/setup.out")"
  cat "$step_log" >&2
  ((setup_exit == 0)) ||
    die "$WHOOPER_REPO_SETUP failed$(awk 'NF { line = $0 } END { if (line != "") print ": " line }' "$step_log")"
  set -a
  source "$work/setup.env"
  set +a
fi
step=review step_log=""

# The run reads the change with its own git diff (prompts/review.md), so its environment gives git, as
# config entries, which outrank the user's config files, the settings diff.patch's arguments pin, with
# color.diff=never for --no-color, and diff.noprefix=false, diff.srcPrefix=a/, and diff.dstPrefix=b/ for
# a/ and b/, and diff.relative=false, so a git diff the run starts in a subfolder of the head, as after
# a probe's cd, still shows the whole change. --no-ext-diff and --no-textconv have no such entry: git
# fails to start an empty diff.external rather than turn it off, and a textconv filter goes with the
# diff attribute that names it, so core.attributesFile=/dev/null leaves the run only those the repo's
# .gitattributes names; prompts/review.md tells the run to pass both flags instead (README.md). The
# entries come after any the environment already holds, so of two entries of the same name the run's
# wins. The run then sees the hunks, and so the lines inside them, that diff.patch shows, and that
# GitHub takes comments on.
config_count="${GIT_CONFIG_COUNT:-0}"
run_config=()
for setting in diff.context=3 diff.interHunkContext=0 diff.algorithm=myers diff.indentHeuristic=true \
  diff.suppressBlankEmpty=false diff.renames=true diff.renameLimit=1000 diff.orderFile=/dev/null core.quotePath=true \
  core.bigFileThreshold=512m core.attributesFile=/dev/null diff.ignoreSubmodules=none diff.submodule=short \
  diff.noprefix=false diff.srcPrefix=a/ diff.dstPrefix=b/ color.diff=never core.abbrev=12 diff.relative=false; do
  run_config+=("GIT_CONFIG_KEY_$config_count=${setting%%=*}" "GIT_CONFIG_VALUE_$config_count=${setting#*=}")
  config_count=$((config_count + 1))
done

# Each step runs lib/whooper.py <step> <run directory> to save one file for the review screen, and stops at
# a time limit of its own. Whatever it finds, and even if it fails, the review goes on as it would without
# the file. A step runs in a process group of its own, as the run does, so an interrupt reaches the cleanup
# at once and the cleanup stops everything the step started, and with the run's environment, since a step
# may run the PR's tests: no GitHub login, temporary files in the run directory, and the run's git
# settings, with which gremlins' git diff in the mutation step finds the lines diff.patch adds. Its output
# goes to the error output, so this script's output stays the run directory alone.
run_step() {
  step_file="$work/$1.group"
  (
    exec env GH_TOKEN=disabled GIT_SSH_COMMAND=false GIT_TERMINAL_PROMPT=0 TMPDIR="$run/tmp" \
      "${run_config[@]}" GIT_CONFIG_COUNT="$config_count" \
      "$root/lib/python" "$root/lib/whooper.py" session "$step_file" \
      "$root/lib/python" "$root/lib/whooper.py" "$1" "$run" < /dev/null >&2
  ) &
  wait "$!" || echo "whooper-review: the $1 step failed, so the review has no $2" >&2
  stop_group "$step_file"
  step_file=""
}

# Before the run starts, while the head's worktree holds the head as committed, the test-gaps step saves
# test_gaps.json: which changed Go, JavaScript, and TypeScript lines no test ran (lib/whooper.py's test_gaps). The facts name it for the
# run, which may also change it, so a copy outside the run directory replaces it once the run ends.
run_step test-gaps test_gaps.json
gaps=""
if [[ -f "$run/test_gaps.json" ]] && cp "$run/test_gaps.json" "$work/test_gaps.json"; then
  gaps="
- test_gaps.json: $run/test_gaps.json, the changed Go, JavaScript, and TypeScript lines no test ran, which Whooper measured before this run started"
fi

untagged=""
if [[ "$source" == slack_ask && "$tagged" == false ]]; then
  untagged="
- The work came from an untagged team ask: decide first whether the PR is small or mechanical."
fi
# The prompt stays in the run directory as a record of what the run was told.
{
  "$root/lib/python" "$root/lib/whooper.py" prompt review "$repo" "$WHOOPER_REVIEW_AGENT"
  cat <<EOF

## This run

- Pull request: https://github.com/$repo/pull/$pr, base $base_ref. Why it is $WHOOPER_GITHUB_LOGIN's work: $reason$untagged
- Head: $head_sha, checked out in $run/head, the working directory.
- Merge base: $merge_base, checked out in $run/base.
- Run directory: $run. Write log.md and overview.json there.
- github.json: $github
- Repository setup: $setup$gaps
EOF
} > "$run/prompt.md"

# GitHub refuses the run: gh sends the token "disabled", and git's credential helper (gh) hands git
# the same. The launcher starts in a session of its own (lib/whooper.py session), so the run and
# everything it starts form one process group that the time limit and the cleanup can stop, and none
# of it reads the terminal; the group's ID goes in agent.group in the work folder (stop_group).
agent_file="$work/agent.group"
(
  cd "$run/head"
  exec env GH_TOKEN=disabled GIT_SSH_COMMAND=false GIT_TERMINAL_PROMPT=0 TMPDIR="$run/tmp" \
    "${run_config[@]}" GIT_CONFIG_COUNT="$config_count" \
    "$root/lib/python" "$root/lib/whooper.py" session "$agent_file" \
    "$root/agents/$WHOOPER_REVIEW_AGENT/review" "$run/prompt.md" < /dev/null
) &
# Waiting on a background run lets an interrupt reach the cleanup at once.
agent_group=$!
watchdog "$((WHOOPER_REVIEW_TIMEOUT_MINUTES * 60))" &
watchdog_pid=$!
# set -e would stop the script at a failed wait, before it says where the run's errors are.
agent_exit=0
wait "$agent_group" || agent_exit=$?
kill "$watchdog_pid" 2>/dev/null || true
watchdog_pid=""
# As run_step does for a step, this stops whatever the run left running, such as a server a probe started, and forgets
# agent.group, since the system may give the group's ID to another program's group once its processes have all ended.
stop_group "$agent_file"
agent_file=""

# Only Whooper's own runs fill test_gaps.json and examples.json: the copy from before the run replaces the
# first, whatever the run did to it, and the examples the run chose, which it wrote as examples.json, move to
# examples.request.json, where the examples step below reads them.
rm -rf "$run/test_gaps.json" || true
[[ ! -e "$work/test_gaps.json" ]] || mv "$work/test_gaps.json" "$run/test_gaps.json" || true
[[ ! -e "$run/examples.json" ]] || mv -f "$run/examples.json" "$run/examples.request.json" || rm -rf "$run/examples.json" || true

# The overview is checked as soon as the run ends, even one past its time limit, after an overview the
# run wrote inside findings.json leaves that file, so it cannot fail the findings' check below.
# Whatever the check finds, and even if it fails, the review goes on as it would without an overview.
"$root/lib/python" "$root/lib/whooper.py" overview "$run" || true

# Then, while the worktrees exist, the connections step writes connections.json: how the code the diff
# changes connects, from gopls for Go files, the TypeScript a file's package installed for JavaScript and
# TypeScript files, and name search for the rest (lib/whooper.py's connections).
run_step connections connections.json
# Then, when the run chose examples, the examples step writes examples.json: what the Go functions the run
# chose return for the inputs it chose, from its test run once at the head and twice at the merge base,
# without the run's edits (lib/whooper.py's examples).
run_step examples examples.json
# Then, when test_gaps.json measured changed Go lines, the mutation step has gremlins change each changed Go line tests ran,
# one small change at a time, and adds to test_gaps.json which lines survived, every test still passing, and which were
# caught (lib/whooper.py's mutation). It first puts back the committed text of each Go file the run changed in the head's
# worktree, so gremlins changes the reviewed commit, and it stops after 15 minutes.
run_step mutation "survived or caught lines in test_gaps.json"

# Each check names its own step, which failure.json names the cause by.
step=time-limit
[[ ! -e "$work/timed-out" ]] ||
  die "the review run passed its $WHOOPER_REVIEW_TIMEOUT_MINUTES-minute limit; see $run/stderr.log and the transcript in $run"
step=findings
[[ -s "$run/findings.json" ]] ||
  die "the review run exited $agent_exit without findings; see $run/stderr.log and the transcript in $run"
# A finding that does not fit the schema would break classify, post, and the summary later.
"$root/lib/python" "$root/lib/whooper.py" check "$root/schemas/findings.json" "$run/findings.json" ||
  { mv "$run/findings.json" "$run/findings.invalid.json"; die "the review run's findings.json does not fit the schema"; }
[[ -f "$run/log.md" ]] || echo "whooper-review: the run wrote no log.md" >&2
finished=true
