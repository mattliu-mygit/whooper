#!/usr/bin/env bash
# Prints the work items to start, one JSON object per line: the newest poll's, and the recheck
# list's in <state>/rechecks, PRs whose head whooper-post or whooper-submit found moved since their
# review, or whose review the user asked for again with bin/whooper-retry. It drops the items a record
# under <state>/prs marks as handled, printing each with its reason on stderr, but not an item whose
# record says retry, and deletes the recheck list's entries that no longer wait: the poll lists the
# PR, or the review at the listed head is done or has failed 3 times.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
eval "$("$root/lib/python" "$root/lib/whooper.py" env)"
exec "$root/lib/python" "$root/lib/whooper.py" select "$WHOOPER_STATE"
