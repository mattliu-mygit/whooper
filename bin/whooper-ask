#!/usr/bin/env bash
# Answers a question about a review run with a new run of the agent that did the review, through its
# launcher agents/<agent>/ask, prints the answer, and saves it in the run's directory as asks/<n>.json:
#
#   whooper-ask <run-id> <question> [--finding <finding-id>]
#
# The run's directory is <state>/runs/<run-id>/, where <state> is $XDG_STATE_HOME/whooper (default
# ~/.local/state/whooper). A review that is still running gets no ask: while a live whooper-review
# holds the PR's lock for the run, this refuses and says so. A review whooper-review stopped before
# it wrote run.json, such as when the fetch failed or the skills could not be hashed, left
# failure.txt and recorded no agent, so the agent the config's [jobs] review names answers about it.
# An empty or unreadable run.json counts as none. The new run loads the review's skills
# ([review] skills) and may read the review's record there: first failure.txt, the reason
# whooper-review gave when it stopped the review, then log.md, findings.json, diff.patch, the
# transcript, github.json, and the other record files the run has, earlier asks included. Its prompt
# is prompts/ask.md filled in, then those files' paths, the finding --finding names, and the
# question. A review that did not finish left no findings.json Whooper can read, and for it the
# prompt also names its agent's stderr.log and stdout.log, which may say why, and
# findings.invalid.json, the findings that did not fit the schema.
# It can write nothing but its answer, has no GitHub login, and has every Slack write denied, as in
# reviews (README.md, "Ask about a review"). A run that passes [ask] timeout_minutes is stopped with
# everything it started.
#
# Questions are numbered in order from 1. asks/<n>.json holds the question, the finding ID or null,
# the answer, the agent, started_at and ended_at (UTC), and the transcript's path, and appears whole,
# through a rename. asks/<n>.prompt.md is the prompt. A run that fails or passes its limit saves no
# answer, and its number is not used again; its prompt and transcript stay for a look.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
eval "$("$root/lib/python" "$root/lib/whooper.py" env)"
# With a job on claude, refuse a Claude Code older than 2.1.295 (lib/whooper.py's check_claude).
"$root/lib/python" "$root/lib/whooper.py" claude-version || exit 1
usage="usage: whooper-ask <run-id> <question> [--finding <finding-id>]"

die() {
  echo "whooper-ask: $*" >&2
  exit 1
}

run_id="" question="" finding=""
while (($#)); do
  case "$1" in
    --finding)
      (($# > 1)) || die "$usage"
      finding="$2"
      shift
      ;;
    *)
      if [[ -z "$run_id" ]]; then
        run_id="$1"
      elif [[ -z "$question" ]]; then
        question="$1"
      else
        die "$usage"
      fi
      ;;
  esac
  shift
done
[[ -n "$run_id" && -n "$question" ]] || die "$usage"
# A run ID names a folder right under runs/, so lib/whooper.py refuses one such as ../x.
run="$("$root/lib/python" "$root/lib/whooper.py" run-dir "$WHOOPER_STATE" "$run_id" whooper-ask)" || exit 1
# whooper-review fills run.json with one jq, and the file stays empty when that jq fails, as when the
# skills cannot be hashed, so a run.json jq cannot read counts as missing.
if jq -e . "$run/run.json" > /dev/null 2>&1; then
  # A review that is still running has not written its whole record. Its whooper-review holds the
  # PR's lock, which names the run; by whooper-review's own rule, a lock whose process is gone, or is
  # now some other program, is stale. The run's tmp folder cannot tell, since a kill -9 of
  # whooper-review leaves it behind.
  lock="$WHOOPER_STATE/locks/$(jq -r '"\(.repo | sub("/"; "-"))-\(.pr)"' "$run/run.json")"
  holder="$(cat "$lock/pid" 2>/dev/null || true)"
  if [[ -n "$holder" && "$(cat "$lock/run_id" 2>/dev/null)" == "$run_id" ]] \
    && ps -o command= -p "$holder" 2>/dev/null | grep -q whooper-review; then
    die "the review is still running, in process $holder; ask again once it ends"
  fi
  # A run from before run.json recorded its agent was a claude run, as whooper-classify assumes.
  agent="$(jq -r '.agent // "claude"' "$run/run.json")"
elif [[ -f "$run/failure.txt" ]]; then
  # whooper-review stopped this review before it wrote run.json, such as when the fetch failed or
  # the skills could not be hashed, and no agent ran. whooper-review writes failure.txt as it stops,
  # so nothing more comes into the record, and this need not check whether the review still runs.
  # With no agent recorded, the agent the config's [jobs] review names answers.
  agent="$WHOOPER_REVIEW_AGENT"
else
  die "no run $run_id in $WHOOPER_STATE/runs"
fi
[[ -x "$root/agents/$agent/ask" ]] || die "$run ran on $agent, which has no agents/$agent/ask"

work=""
agent_group="" agent_file="" watchdog_pid=""
finished=false
# As in whooper-review: stops the run's process group, named by the file lib/whooper.py session writes its ID in, and
# everything the run started, with a SIGKILL to whatever is left 4 seconds after the TERM (lib/stop-group), or keeps a
# run that has not yet made its group from starting.
stop_group() {
  if [[ -n "$1" ]] && "$root/lib/stop-group" "$1"; then
    wait "$(cat "$1")" 2>/dev/null || true
  fi
}
# As in whooper-review: once the time limit passes, the watchdog marks the run timed out and stops it with stop_group, so
# a run that has not yet made its process group never starts, and a TERM to the watchdog stops its sleep too.
watchdog() {
  local me
  me="$(exec /bin/sh -c 'echo "$PPID"')"
  trap 'pkill -P "$me"; exit' TERM
  sleep "$1" &
  wait "$!" || exit 0
  : > "$work/timed-out"
  stop_group "$agent_file"
}
cleanup() {
  local status=$?
  # As in whooper-review, a process bash forked for a background command that runs this trap, as when it
  # cannot expand the command's words, exits at once, so only this script's own process stops the run and
  # removes the work folder.
  if [[ "$(exec /bin/sh -c 'echo "$PPID"')" != "$$" ]]; then
    exit "$status"
  fi
  # As in whooper-review, bash 3.2, macOS's /bin/bash, runs this with $? at 0 when set -u stops the script
  # on an unset variable. An ask that did not finish exits 1 then, so its caller does not take it for one
  # that printed an answer.
  if [[ "$finished" != true ]] && ((status == 0)); then
    status=1
  fi
  # As in whooper-review, this also stops anything the run left running.
  stop_group "$agent_file"
  # As in whooper-review, this stops each process this script started that is left by now, the watchdog
  # among them, since bash 3.2 can run the trap before watchdog_pid holds its process ID.
  pkill -P "$$" 2>/dev/null || true
  rm -rf "$work"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP
# As in whooper-review, the work folder comes after the traps, from a mktemp that ignores INT, TERM,
# and HUP, so no signal leaves it behind.
work="$(trap '' INT TERM HUP; mktemp -d)"

# lib/whooper.py refuses a finding the run lacks before this ask takes a number.
"$root/lib/python" "$root/lib/whooper.py" prompt ask "$agent" "$run" "$question" ${finding:+"$finding"} \
  > "$work/prompt.md"
asks="$run/asks"
mkdir -p "$asks"
# noclobber makes the redirect fail when the file exists, so of two asks started at once each takes
# its own number, and a number an earlier ask took, answered or not, is not used again.
n=1
while ! (set -o noclobber && cat "$work/prompt.md" > "$asks/$n.prompt.md") 2>/dev/null; do
  [[ -e "$asks/$n.prompt.md" ]] || die "cannot write $asks/$n.prompt.md"
  n=$((n + 1))
done

started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
# As in whooper-review: gh, and git's credential helper (gh), get the token "disabled", and the
# launcher starts in a session of its own, so the run and everything it starts form one process
# group that the time limit and the cleanup can stop, and none of it reads the terminal.
agent_file="$work/agent.group"
env GH_TOKEN=disabled GIT_SSH_COMMAND=false GIT_TERMINAL_PROMPT=0 WHOOPER_RUN="$run" \
  "$root/lib/python" "$root/lib/whooper.py" session "$agent_file" \
  "$root/agents/$agent/ask" "$asks/$n.prompt.md" "$work/answer.md" "$asks/$n" < /dev/null &
# Waiting on a background run lets an interrupt reach the cleanup at once.
agent_group=$!
# The limit may be a fraction of a minute, so Python turns it into seconds.
watchdog "$("$root/lib/python" -c 'import sys; print(float(sys.argv[1]) * 60)' "$WHOOPER_ASK_TIMEOUT_MINUTES")" &
watchdog_pid=$!
# set -e would stop the script at a failed wait, before it says where the run's errors are.
agent_exit=0
wait "$agent_group" || agent_exit=$?
kill "$watchdog_pid" 2>/dev/null || true
watchdog_pid=""
# As in whooper-review, this stops whatever the run left running and forgets its group file at once.
stop_group "$agent_file"
agent_file=""

[[ ! -e "$work/timed-out" ]] ||
  die "the ask run passed its $WHOOPER_ASK_TIMEOUT_MINUTES-minute limit; see $asks/$n.*"
((agent_exit == 0)) && grep -q '[^[:space:]]' "$work/answer.md" 2>/dev/null ||
  die "the ask run exited $agent_exit without an answer; see $asks/$n.*"
# Claude's transcript is <n>.transcript.jsonl and Devin's <n>.transcript.json.
transcript=""
for file in "$asks/$n".transcript.*; do
  if [[ -f "$file" ]]; then
    transcript="$file"
  fi
done
jq -n --arg question "$question" --arg finding "$finding" --rawfile answer "$work/answer.md" --arg agent "$agent" \
  --arg started "$started" --arg ended "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg transcript "$transcript" \
  '{question: $question, finding: (if $finding == "" then null else $finding end),
    answer: ($answer | gsub("^\\s+|\\s+$"; "")), agent: $agent, started_at: $started, ended_at: $ended,
    transcript: (if $transcript == "" then null else $transcript end)}' > "$asks/$n.json.tmp"
mv "$asks/$n.json.tmp" "$asks/$n.json"
jq -r .answer "$asks/$n.json"
finished=true
