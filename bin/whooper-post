#!/usr/bin/env bash
# Sends a classified run's auto_post findings to GitHub as one COMMENTED review. Until the user
# approves the rule-file edits in phase 3, it runs only with --print, which writes the request to
# <run dir>/post-request.json and posts nothing:
#
#   whooper-post <run-id> --print
#
# It first re-reads the PR with the user's login. When the head has moved since the run, nothing
# posts, the PR record says stale, and the PR goes on the recheck list, so the next round reviews
# the new head whatever brought the PR in. Otherwise lib/whooper.py holds back each finding that a
# review comment written since the run started covers, or whose draft @-mentions someone or links
# outside the configured orgs, and adds it to the digest. Either way the run's post.json records
# what happened, and a second call refuses.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
eval "$("$root/lib/python" "$root/lib/whooper.py" env)"
data="$WHOOPER_STATE"
usage="usage: whooper-post <run-id> --print"

die() {
  echo "whooper-post: $*" >&2
  exit 1
}

run_id="" print=false
while (($#)); do
  case "$1" in
    --print) print=true ;;
    *)
      [[ -z "$run_id" ]] || die "$usage"
      run_id="$1"
      ;;
  esac
  shift
done
[[ -n "$run_id" ]] || die "$usage"
[[ "$print" == true ]] || die "live posting waits for the user's approval of the rule-file edits; pass --print"
# A run ID names a folder right under runs/, so lib/whooper.py refuses one such as ../x.
run="$("$root/lib/python" "$root/lib/whooper.py" run-dir "$data" "$run_id" whooper-post)" || exit 1
[[ -f "$run/run.json" ]] || die "no run $run_id in $data/runs"
# whooper-review fills run.json with one jq, and the file stays empty when that jq fails, as when the
# skills cannot be hashed. jq then prints nothing, and read, left without a line, would stop this
# script under set -e without saying why.
read -r repo pr < <(jq -r '[.repo, .pr] | @tsv' "$run/run.json" 2>/dev/null) || die "cannot read $run/run.json"

# As in whooper-summary, the traps come before the work folder, so no signal leaves it behind.
work=""
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT TERM HUP
work="$(trap '' INT TERM HUP; mktemp -d)"
head_now="$(gh api "repos/$repo/pulls/$pr" --jq .head.sha)"
# --paginate prints one array per page.
gh api --paginate "repos/$repo/pulls/$pr/comments?per_page=100" | jq -s add > "$work/comments.json"
"$root/lib/python" "$root/lib/whooper.py" post "$data" "$run" "$head_now" "$work/comments.json"
