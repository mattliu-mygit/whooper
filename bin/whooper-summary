#!/usr/bin/env bash
# Posts a run's summary to the summary channel after bin/whooper-post has handled the run, or with
# --print only prints it:
#
#   whooper-summary <run-id> [--print]
#
# lib/whooper.py composes the text from the run's records. The agent the config's [jobs] summary
# names then delivers it through its launcher agents/<agent>/summary: Claude schedules it in the
# summary channel, and Devin, which cannot reach Slack, writes it to <run dir>/summary.md.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
eval "$("$root/lib/python" "$root/lib/whooper.py" env)"
# With a job on claude, refuse a Claude Code older than 2.1.295 (lib/whooper.py's check_claude).
"$root/lib/python" "$root/lib/whooper.py" claude-version || exit 1
data="$WHOOPER_STATE"
usage="usage: whooper-summary <run-id> [--print]"

die() {
  echo "whooper-summary: $*" >&2
  exit 1
}

run_id="" print=false
while (($#)); do
  case "$1" in
    --print) print=true ;;
    *)
      [[ -z "$run_id" ]] || die "$usage"
      run_id="$1"
      ;;
  esac
  shift
done
[[ -n "$run_id" ]] || die "$usage"
run="$data/runs/$run_id"
[[ -f "$run/post.json" ]] || die "$run has not been through bin/whooper-post"

# As in whooper-review, the work folder comes after the traps, from a mktemp that ignores INT, TERM,
# and HUP, so no signal leaves it behind. The INT, TERM, and HUP trap is what makes bash set work
# first: with only the EXIT trap, bash would run it on such a signal before work named the folder.
work=""
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT TERM HUP
work="$(trap '' INT TERM HUP; mktemp -d)"
"$root/lib/python" "$root/lib/whooper.py" summary "$run" > "$work/summary.txt"
if [[ "$print" == true ]]; then
  cat "$work/summary.txt"
  echo
  exit
fi

"$root/agents/$WHOOPER_SUMMARY_AGENT/summary" "$work/summary.txt" "$run"
