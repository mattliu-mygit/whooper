#!/usr/bin/env bash
# Runs the poll's judgment on Claude Code: agents/claude/poll <prompt file> <answer file> <record prefix>.
#
# The prompt holds the ask channel's posts, so the run gets no tools, no MCP servers, and no
# CLAUDE.md files: Slack text it reads cannot make it do anything. Its structured output, checked
# against schemas/slack-asks.json, becomes the answer file. Its transcript is
# <record prefix>.transcript.jsonl.
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
CLAUDE_CODE_DISABLE_CLAUDE_MDS=1 CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 claude -p "$(<"$1")" \
  --model "$WHOOPER_CLAUDE_POLL_MODEL" \
  --setting-sources user --strict-mcp-config --tools "" --disable-slash-commands --no-session-persistence \
  --json-schema "$(<"$root/schemas/slack-asks.json")" \
  --output-format stream-json --verbose > "$3.transcript.jsonl"
jq -e -c 'select(.type == "result" and .subtype == "success" and .structured_output != null) | .structured_output' \
  "$3.transcript.jsonl" > "$2"
