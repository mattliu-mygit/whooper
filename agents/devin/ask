#!/usr/bin/env bash
# Answers a question about a review on Devin: agents/devin/ask <prompt file> <answer file> <record prefix>.
#
# bin/whooper-ask starts this with no GitHub login. The run starts in an empty directory in
# accept-edits permission mode, so it may read any file, the review's record included, and write
# files only in that directory, and anything else needs an approval that nobody gives. It writes its
# answer there as answer.md with its file-writing tool, which moves to the answer file. Its config,
# <record prefix>.devin-config.json, is the user's ~/.config/devin/config.json, so it loads the
# user's skills as a review does, with two changes:
#   - none of the user's allow rules, any of which could approve a command, or a write outside that
#     directory, without asking;
#   - deny rules for the shell and for every tool of the two Slack servers Devin can load, which hold
#     whatever else would approve the call.
# Its transcript is <record prefix>.transcript.json, and its Devin session is deleted once it ends.
set -euo pipefail

user_config="$HOME/.config/devin/config.json"
[[ -f "$user_config" ]] || user_config=/dev/null
jq -n --slurpfile user "$user_config" '
  ($user[0] // {})
  | .permissions.allow = []
  | .permissions.deny += ["exec", "mcp__slack-remote__*", "mcp__slack__*"]' > "$3.devin-config.json"
# As in bin/whooper-summary, the traps come before the work folder, so no signal leaves it behind.
work=""
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT TERM HUP
work="$(trap '' INT TERM HUP; mktemp -d)"
{
  cat "$1"
  printf '\nThis run rejects shell commands: read files with your file-reading and search tools, and write your answer to answer.md in the working directory with your file-writing tool. Write no other file.\n'
} > "$work/prompt.md"
cd "$work"
status=0
# Devin Desktop sets ACP_BACKEND and WINDSURF_EXT_HOST_PID in its shells. The CLI ignores its own
# login while ACP_BACKEND is set, and its agent quits within seconds once the process named by
# WINDSURF_EXT_HOST_PID has exited, as it does when Devin Desktop restarts or reloads.
env -u ACP_BACKEND -u WINDSURF_EXT_HOST_PID devin -p --prompt-file prompt.md \
  --config "$3.devin-config.json" --model "$WHOOPER_DEVIN_REVIEW_MODEL" \
  --permission-mode accept-edits --respect-workspace-trust false \
  --export "$3.transcript.json" > /dev/null 2> "$3.stderr.log" || status=$?
# Delete the run's Devin session so asks don't fill Devin Desktop's session list; the transcript
# keeps the whole conversation.
[[ -f "$3.transcript.json" ]] &&
  devin rm "$(jq -r .session_id "$3.transcript.json")" --force > /dev/null || true
((status == 0)) || exit "$status"
mv answer.md "$2"
