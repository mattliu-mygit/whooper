{
  "type": "object",
  "required": ["status", "skip_reason", "approval", "findings"],
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["reviewed", "skipped"] },
    "skip_reason": { "type": "string", "description": "Why an untagged team ask was skipped; empty when reviewed." },
    "approval": {
      "type": "object",
      "required": ["verdict", "reason"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "enum": ["approve_once_ci_passes", "look_first"] },
        "reason": { "type": "string", "description": "What the verdict rests on: what was checked, and what was not." }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "path", "line", "side", "title", "draft", "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string", "description": "Repository-relative path of the file the comment goes on." },
          "line": { "type": "integer", "minimum": 1 },
          "side": { "enum": ["LEFT", "RIGHT"], "description": "RIGHT for a line of the head, LEFT for a deleted line." },
          "in_diff": { "type": "boolean", "description": "Not used: Whooper reads it from the diff; leave it out." },
          "title": { "type": "string" },
          "draft": { "type": "string", "description": "The comment as the user would post it, with no marker or support label." },
          "kind": { "enum": ["caller_visible_bug", "ci_failure", "nit", "question", "other"] },
          "nit_kind": {
            "enum": [
              "codeowners_no_effect", "docstring_contradicts_code", "public_doc_contradicts_code", "redundant_code", "wording", "other"
            ],
            "description": "Only for kind nit."
          },
          "rule_v1": { "type": "object", "description": "Not used: reviews before the auto-post pipeline was removed wrote it. Leave it out." },
          "head_run": { "type": "string", "description": "Not used; leave it out." },
          "base_run": { "type": "string", "description": "Not used; leave it out." },
          "observed": { "type": "string", "description": "Not used; leave it out." }
        }
      }
    }
  }
}
