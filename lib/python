#!/usr/bin/env bash
# Runs Python for Whooper's scripts, with the packages lib/whooper.py needs:
#
#   lib/python <python arguments>, such as lib/python lib/whooper.py env
#
# uv builds an environment from the block at the top of lib/whooper.py: a Python that fits its
# requires-python and its dependencies at the versions lib/whooper.py.lock pins. --locked fails
# instead of changing that lockfile. The environment's Python then runs with -I (isolated mode),
# which leaves the working directory, PYTHON* variables, and the user's site-packages out of what it
# imports, because a review run starts its launcher from the PR's checkout, which the PR's author
# controls. uv run would drop -I, so uv only builds the environment. uv also reads uv.toml,
# pyproject.toml, and .python-version from the directory it runs in, so it runs in this one.
set -euo pipefail

lib="$(cd "$(dirname "$0")" && pwd)"
uv --directory "$lib" sync --locked --quiet --script whooper.py
python="$(uv --directory "$lib" python find --script whooper.py)"
exec "$python" -I "$@"
