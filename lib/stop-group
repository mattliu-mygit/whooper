#!/usr/bin/env bash
# Stops a program that lib/whooper.py session started, and everything the program started:
#
#   lib/stop-group <group file>
#
# session writes the ID of the program's process group to the group file once it has made the group. While the file is
# missing, as when the command that starts the program stops the moment it starts it, this makes the file instead and
# exits 1, and session, finding it, or no folder for it once the command's cleanup removes that, exits without starting
# the program: however the two meet, the program stops or never starts. A group file that is empty, as one this made,
# also exits 1, and so does an empty argument.
#
# Otherwise this sends the group a TERM, which each of Whooper's commands passes on to the groups it started as its
# cleanup stops them, and waits up to 4 seconds, under the 5 Prompting Time gives whooper-run between its TERM and its
# SIGKILL, for the group and every group below it to end: the groups of the processes in the group and of every process
# those started, however deep, as they were when this sent the TERM, so the group of an agent that ignores TERM counts
# even after its launcher ends at the TERM. Then it sends SIGKILL to whatever is left of those groups and of the groups
# below them now, so a stop ends the whole tree within the 4 seconds even when a cleanup in it hangs, though each of
# Whooper's commands starts its programs in groups of their own, which a SIGKILL to the top group alone would miss.
# Before the SIGKILL it sends SIGSTOP to those groups until no new group appears, so no process forks or makes a group
# of its own between the list and the SIGKILL. It exits 0 once all of it has ended.
#
# A group whose processes have all ended may get its ID reused by another program's group, so a command calls this as
# soon as a program it waited for ends, and forgets the group file then.
set -uo pipefail
# A second Ctrl-C reaches this as it reaches its caller, in the foreground group they share. This ignores it, and ends
# on its own within about 6 seconds, so the second Ctrl-C cannot leave the stop half done.
trap '' INT TERM HUP

file="${1:-}"
# noclobber makes the redirect fail when the file exists, so this makes the file only while it is missing.
if [[ -z "$file" ]] || (set -o noclobber; : > "$file") 2>/dev/null; then
  exit 1
fi
group="$(cat "$file" 2>/dev/null)"
[[ -n "$group" ]] || exit 1

# Prints, in order, one a line, the process groups below the groups named in the arguments: the group of each process in
# them and of each process those started, however deep, by parent process ID. It never prints the group of this script
# or of a process it descends from, so a group ID the system gave one of them cannot freeze or kill this script's caller.
below() {
  ps -A -o pid= -o ppid= -o pgid= | awk -v groups="$*" -v me="$$" '
    BEGIN { n = split(groups, list, " "); for (i = 1; i <= n; i++) seed[list[i]] = 1 }
    { parent[$1] = $2; group[$1] = $3 }
    END {
      for (p in group) if ((group[p]) in seed) under[p] = 1
      do {
        more = 0
        for (p in parent) if (!(p in under) && ((parent[p]) in under)) { under[p] = 1; more = 1 }
      } while (more)
      for (p = me; p > 1 && (p in parent); p = parent[p]) mine[group[p]] = 1
      for (p in under) if (!((group[p]) in mine)) out[group[p]] = 1
      for (g in out) print g
    }' | sort -n
}

# Succeeds while any group in $groups has a process. A group of zombies alone fails too: kill -0 sends nothing to one.
left() {
  local g
  for g in $groups; do
    kill -0 -- "-$g" 2>/dev/null && return 0
  done
  return 1
}

groups="$group"
left || exit 0
groups="$(below "$group")"
kill -TERM -- "-$group" 2>/dev/null
# SECONDS counts whole seconds, so this waits 3 to 4 seconds.
end=$((SECONDS + 4))
while left && ((SECONDS < end)); do
  sleep 0.1
done
left || exit 0
while :; do
  for g in $groups; do
    kill -STOP -- "-$g" 2>/dev/null
  done
  found="$(below $groups)"
  [[ "$found" != "$groups" ]] || break
  groups="$found"
done
for g in $groups; do
  kill -KILL -- "-$g" 2>/dev/null
done
# A process ends at its SIGKILL unless it waits on the disk, so this waits up to 2 seconds more for all of them.
end=$((SECONDS + 2))
while left && ((SECONDS < end)); do
  sleep 0.1
done
exit 0
