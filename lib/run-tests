#!/usr/bin/env bash
# Runs Whooper's tests in parallel, under the usual PATH and with /usr/bin:/bin first at once; see
# lib/run_tests.py:
#
#   lib/run-tests [-k <pattern>]... [-j <workers>]
#
# Tests that move HOME still find uv's cache, through UV_CACHE_DIR, so lib/python need not build its
# environment again in each.
set -euo pipefail

lib="$(cd "$(dirname "$0")" && pwd)"
UV_CACHE_DIR="${UV_CACHE_DIR:-$(uv cache dir)}"
export UV_CACHE_DIR
exec "$lib/python" "$lib/run_tests.py" "$@"
